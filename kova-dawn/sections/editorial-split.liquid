<section class="kv-section" style="padding-top:32px;">
  <div class="kv-container">
    <div class="kv-editorial">
      <div class="kv-editorial__img">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 900 }}"
            alt="{{ section.settings.image.alt | escape | default: section.settings.heading }}"
            width="900"
            height="1125"
            loading="lazy"
          >
        {%- else -%}
          <img
            src="https://images.unsplash.com/photo-1469334031218-e382a71b716b?auto=format&fit=crop&w=1200&q=80"
            alt="KOVA atelier"
            width="900"
            height="1125"
            loading="lazy"
            style="width:100%;height:100%;object-fit:cover;"
          >
        {%- endif -%}
      </div>
      <div class="kv-editorial__copy">
        {%- if section.settings.label != blank -%}
          <span class="t-micro" style="color:var(--color-clay);">{{ section.settings.label }}</span>
        {%- endif -%}
        <h2 class="t-h1">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="t-body-lg" style="color:#444;">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
          <div style="margin-top:8px;">
            <a class="kv-btn kv-btn--out" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial Split",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "The Studio"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Built on restraint, not seasons."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body text",
      "default": "Every KOVA piece begins as a sketch refined until nothing else can be removed. We work with mills who treat fabric as an heirloom and ateliers who treat tailoring as a quiet craft."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Our approach"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Editorial Split",
      "settings": {
        "label": "The Studio",
        "heading": "Built on restraint, not seasons.",
        "text": "Every KOVA piece begins as a sketch refined until nothing else can be removed. We work with mills who treat fabric as an heirloom and ateliers who treat tailoring as a quiet craft.",
        "cta_label": "Our approach"
      }
    }
  ]
}
{% endschema %}
