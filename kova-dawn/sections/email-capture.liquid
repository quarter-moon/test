<section class="kv-email">
  <div class="kv-container">
    <span class="t-micro" style="color:var(--color-clay);">{{ section.settings.label }}</span>
    <h2 class="t-h1" style="margin-top:12px;color:var(--color-white);">{{ section.settings.heading }}</h2>
    {%- if section.settings.subtext != blank -%}
      <p class="t-body-lg" style="max-width:480px;margin:16px auto 0;opacity:0.75;">{{ section.settings.subtext }}</p>
    {%- endif -%}

    {%- form 'customer', id: 'ContactFooter', class: 'kv-email__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input
        type="email"
        name="contact[email]"
        id="NewsletterForm--{{ section.id }}"
        placeholder="{{ section.settings.placeholder }}"
        required
        autocorrect="off"
        autocapitalize="off"
        autocomplete="email"
      >
      <button type="submit" aria-label="{{ section.settings.submit_label | default: 'Subscribe' }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </button>
    {%- endform -%}

    <div class="kv-email__meta">By subscribing you agree to our privacy policy</div>
  </div>
</section>

{% schema %}
{
  "name": "Email Capture",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "The Quiet Letter"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Considered new arrivals, monthly."
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "One email a month. Lookbook previews, atelier notes, no noise."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit label",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "Email Capture",
      "settings": {
        "label": "The Quiet Letter",
        "heading": "Considered new arrivals, monthly.",
        "subtext": "One email a month. Lookbook previews, atelier notes, no noise.",
        "placeholder": "Enter your email"
      }
    }
  ]
}
{% endschema %}
