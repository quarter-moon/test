<style>
/* ─── Satoshi-style PDP: vertical thumb strip + large main image ─── */
.kv-pdp-s {
  display: grid;
  grid-template-columns: 55fr 45fr;
  gap: 64px;
  padding-top: 40px;
  padding-bottom: 80px;
  align-items: start;
}
@media (max-width: 1023px) {
  .kv-pdp-s { grid-template-columns: 1fr; gap: 40px; }
}

/* Gallery: thumb strip left + main image right */
.kv-pdp-s__gallery {
  position: sticky;
  top: calc(var(--nav-h) + 24px);
  display: grid;
  grid-template-columns: 80px 1fr;
  gap: 12px;
  align-items: start;
}
@media (max-width: 1023px) {
  .kv-pdp-s__gallery {
    position: static;
    grid-template-columns: 1fr;
  }
}

/* Vertical thumbnail strip */
.kv-pdp-s__thumbs {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
@media (max-width: 1023px) {
  .kv-pdp-s__thumbs { display: none; }
}

.kv-pdp-s__thumb {
  width: 80px;
  aspect-ratio: 3/4;
  overflow: hidden;
  background: var(--color-mist);
  cursor: pointer;
  border: 1px solid transparent;
  transition: border-color 200ms ease, opacity 200ms ease;
  opacity: 0.6;
  flex-shrink: 0;
}
.kv-pdp-s__thumb img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
}
.kv-pdp-s__thumb:hover { opacity: 0.9; }
.kv-pdp-s__thumb.is-active {
  border-color: var(--color-ink);
  opacity: 1;
}

/* Main image */
.kv-pdp-s__main {
  aspect-ratio: 3/4;
  background: var(--color-mist);
  overflow: hidden;
  position: relative;
}
.kv-pdp-s__main img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  transition: opacity 250ms ease;
}

/* Mobile carousel */
.kv-pdp-s__carousel {
  display: none;
  position: relative;
  aspect-ratio: 3/4;
  overflow: hidden;
  background: var(--color-mist);
  touch-action: pan-y;
}
.kv-pdp-s__carousel-track {
  display: flex;
  height: 100%;
  transition: transform 350ms ease;
}
.kv-pdp-s__carousel-slide {
  flex: 0 0 100%;
  height: 100%;
}
.kv-pdp-s__carousel-slide img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
}
.kv-pdp-s__dots {
  position: absolute;
  bottom: 16px;
  left: 0; right: 0;
  display: flex;
  justify-content: center;
  gap: 6px;
}
.kv-pdp-s__dot {
  width: 6px; height: 6px;
  border-radius: 999px;
  background: rgba(255,255,255,0.55);
  border: none;
  cursor: pointer;
  padding: 0;
  transition: background 200ms ease, transform 200ms ease;
}
.kv-pdp-s__dot.is-active {
  background: var(--color-white);
  transform: scale(1.3);
}
@media (max-width: 1023px) {
  .kv-pdp-s__carousel { display: block; }
}

/* Product info column */
.kv-pdp-s__info {
  position: sticky;
  top: calc(var(--nav-h) + 24px);
  display: flex;
  flex-direction: column;
  gap: 20px;
}
@media (max-width: 1023px) {
  .kv-pdp-s__info { position: static; }
}

/* Rating row */
.kv-pdp-s__rating {
  display: flex;
  align-items: center;
  gap: 8px;
}
.kv-pdp-s__stars { color: var(--color-clay); font-size: 14px; letter-spacing: 1px; }
.kv-pdp-s__rating-text {
  font-size: 12px;
  color: var(--color-clay);
  text-decoration: underline;
  text-underline-offset: 3px;
  cursor: pointer;
}

/* Price row */
.kv-pdp-s__price {
  display: flex;
  align-items: baseline;
  gap: 12px;
}
.kv-pdp-s__price--current { font-family: var(--font-body); font-size: 22px; font-weight: 500; }
.kv-pdp-s__price--was { font-size: 16px; text-decoration: line-through; color: #999; font-weight: 400; }
.kv-pdp-s__price--sale { color: var(--color-error); }
.kv-pdp-s__price--badge {
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: var(--color-error);
  color: var(--color-white);
  padding: 4px 8px;
  font-weight: 500;
}

/* Short description */
.kv-pdp-s__short-desc { font-size: 14px; line-height: 1.75; color: #555; margin: 0; }

/* Tabs */
.kv-pdp-s__tabs { border-top: 1px solid var(--color-mist); padding-top: 4px; }
.kv-pdp-s__tab-nav {
  display: flex;
  gap: 0;
  border-bottom: 1px solid var(--color-mist);
  margin-bottom: 0;
}
.kv-pdp-s__tab-btn {
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  padding: 12px 20px 12px 0;
  font-family: var(--font-body);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-weight: 500;
  color: #999;
  cursor: pointer;
  transition: color 150ms ease, border-color 150ms ease;
  margin-bottom: -1px;
}
.kv-pdp-s__tab-btn:hover { color: var(--color-ink); }
.kv-pdp-s__tab-btn.is-active { color: var(--color-ink); border-bottom-color: var(--color-ink); }
.kv-pdp-s__tab-panel { display: none; padding: 20px 0 4px; font-size: 14px; line-height: 1.75; color: #444; }
.kv-pdp-s__tab-panel.is-active { display: block; }
.kv-pdp-s__tab-panel p { margin: 0 0 12px; }
.kv-pdp-s__tab-panel p:last-child { margin-bottom: 0; }
.kv-pdp-s__tab-panel ul { margin: 0 0 12px; padding-left: 18px; }
.kv-pdp-s__tab-panel li { margin-bottom: 6px; }

/* Swatch selector */
.kv-pdp-s__option-label {
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-weight: 500;
  display: flex;
  gap: 8px;
  align-items: center;
}
.kv-pdp-s__option-label span { color: #777; text-transform: none; letter-spacing: 0; font-weight: 400; font-size: 13px; }
.kv-pdp-s__swatches { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 10px; }
.kv-pdp-s__swatch {
  width: 28px; height: 28px;
  border-radius: 999px;
  border: 1.5px solid var(--color-mist);
  cursor: pointer;
  transition: transform 150ms ease, box-shadow 150ms ease;
  position: relative;
  background: var(--color-mist);
}
.kv-pdp-s__swatch:hover { transform: scale(1.1); }
.kv-pdp-s__swatch.is-active {
  box-shadow: 0 0 0 2px var(--color-white), 0 0 0 3.5px var(--color-ink);
}

/* Size selector */
.kv-pdp-s__sizes-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}
.kv-pdp-s__size-guide {
  font-size: 12px;
  color: #777;
  text-decoration: underline;
  text-underline-offset: 3px;
  cursor: pointer;
  background: none;
  border: none;
}
.kv-pdp-s__size-guide:hover { color: var(--color-ink); }

/* Qty stepper */
.kv-pdp-s__qty-row {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 12px;
  align-items: center;
}
.kv-pdp-s__qty {
  display: flex;
  align-items: center;
  border: 1px solid var(--color-mist);
  height: 52px;
}
.kv-pdp-s__qty-btn {
  width: 44px; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-size: 20px; font-weight: 300;
  cursor: pointer;
  border: none;
  background: none;
  color: var(--color-ink);
  line-height: 1;
  transition: background 150ms ease;
}
.kv-pdp-s__qty-btn:hover { background: var(--color-stone); }
.kv-pdp-s__qty-num {
  flex: 1;
  text-align: center;
  font-size: 14px;
  font-weight: 500;
  border: none;
  background: none;
  width: 100%;
  padding: 0;
}
.kv-pdp-s__qty-num::-webkit-outer-spin-button,
.kv-pdp-s__qty-num::-webkit-inner-spin-button { -webkit-appearance: none; }

/* Wishlist */
.kv-pdp-s__wishlist {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  background: none;
  border: none;
  cursor: pointer;
  padding: 10px 0;
  color: #555;
  font-family: var(--font-body);
  align-self: center;
  font-weight: 500;
  transition: color 150ms ease;
}
.kv-pdp-s__wishlist:hover { color: var(--color-ink); }
.kv-pdp-s__wishlist svg { transition: fill 150ms ease; }
.kv-pdp-s__wishlist.is-on svg { fill: var(--color-clay); stroke: var(--color-clay); }

/* Trust bar */
.kv-pdp-s__trust {
  display: flex;
  gap: 0;
  border-top: 1px solid var(--color-mist);
  border-bottom: 1px solid var(--color-mist);
  padding: 20px 0;
}
.kv-pdp-s__trust-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #555;
  text-align: center;
  padding: 0 8px;
  border-right: 1px solid var(--color-mist);
}
.kv-pdp-s__trust-item:last-child { border-right: none; }
.kv-pdp-s__trust-icon {
  color: var(--color-clay);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* You may also like */
.kv-pdp-s__recs { padding: 80px 0 96px; border-top: 1px solid var(--color-mist); }
</style>

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign on_sale = false -%}
{%- if product.compare_at_price > product.price -%}
  {%- assign on_sale = true -%}
{%- endif -%}

<div class="kv-container">
  {%- comment -%} Breadcrumb {%- endcomment -%}
  <nav class="kv-breadcrumb" style="padding-top:28px;" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
    {%- if product.collections.first -%}
      <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
    {%- endif -%}
    <span aria-current="page">{{ product.title }}</span>
  </nav>

  <div class="kv-pdp-s">

    {%- comment -%}
      ════════════════════════
      LEFT — Image Gallery
      ════════════════════════
    {%- endcomment -%}
    <div class="kv-pdp-s__gallery" id="kv-gallery">

      {%- comment -%} Vertical thumbnail strip (desktop only) {%- endcomment -%}
      <div class="kv-pdp-s__thumbs" role="list" aria-label="Product images">
        {%- for image in product.images limit: 6 -%}
          <button
            class="kv-pdp-s__thumb{% if forloop.first %} is-active{% endif %}"
            role="listitem"
            data-index="{{ forloop.index0 }}"
            aria-label="View image {{ forloop.index }}"
          >
            <img
              src="{{ image | image_url: width: 160 }}"
              alt="{{ image.alt | escape | default: product.title }}"
              width="80"
              height="107"
              loading="lazy"
            >
          </button>
        {%- else -%}
          <div class="kv-pdp-s__thumb is-active">
            <div class="kv-ph">{{ product.vendor }}</div>
          </div>
        {%- endfor -%}
      </div>

      {%- comment -%} Large main image (desktop) {%- endcomment -%}
      <div class="kv-pdp-s__main" id="kv-main-img-wrap">
        {%- if product.featured_image -%}
          <img
            id="kv-main-img"
            src="{{ product.featured_image | image_url: width: 1000 }}"
            alt="{{ product.featured_image.alt | escape | default: product.title }}"
            width="1000"
            height="1333"
            loading="eager"
          >
        {%- else -%}
          <div class="kv-ph">{{ product.title }}</div>
        {%- endif -%}
      </div>

      {%- comment -%} Mobile swipe carousel {%- endcomment -%}
      <div class="kv-pdp-s__carousel" id="kv-carousel" aria-label="Product images">
        <div class="kv-pdp-s__carousel-track" id="kv-carousel-track">
          {%- for image in product.images limit: 6 -%}
            <div class="kv-pdp-s__carousel-slide">
              <img
                src="{{ image | image_url: width: 800 }}"
                alt="{{ image.alt | escape | default: product.title }}"
                width="800"
                height="1067"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              >
            </div>
          {%- else -%}
            <div class="kv-pdp-s__carousel-slide">
              <div class="kv-ph">{{ product.title }}</div>
            </div>
          {%- endfor -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="kv-pdp-s__dots" role="tablist" aria-label="Image slides">
            {%- for image in product.images limit: 6 -%}
              <button
                class="kv-pdp-s__dot{% if forloop.first %} is-active{% endif %}"
                role="tab"
                data-index="{{ forloop.index0 }}"
                aria-label="Go to image {{ forloop.index }}"
                aria-selected="{{ forloop.first }}"
              ></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

    </div>

    {%- comment -%}
      ════════════════════════
      RIGHT — Product info
      ════════════════════════
    {%- endcomment -%}
    <div class="kv-pdp-s__info">

      {%- comment -%} Vendor {%- endcomment -%}
      <span class="t-micro" style="color:var(--color-clay);">{{ product.vendor }}</span>

      {%- comment -%} Title {%- endcomment -%}
      <h1 class="t-h1" style="margin:0;">{{ product.title }}</h1>

      {%- comment -%} Star rating placeholder {%- endcomment -%}
      <div class="kv-pdp-s__rating">
        <span class="kv-pdp-s__stars" aria-label="4.8 out of 5 stars">★★★★★</span>
        <a class="kv-pdp-s__rating-text" href="#kv-tab-description" aria-label="Read 124 reviews">4.8 · 124 reviews</a>
      </div>

      {%- comment -%} Price {%- endcomment -%}
      <div class="kv-pdp-s__price" id="kv-price">
        {%- if on_sale -%}
          <span class="kv-pdp-s__price--current kv-pdp-s__price--sale">{{ current_variant.price | money }}</span>
          <span class="kv-pdp-s__price--was">{{ current_variant.compare_at_price | money }}</span>
          {%- assign saving = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price -%}
          <span class="kv-pdp-s__price--badge">−{{ saving }}%</span>
        {%- else -%}
          <span class="kv-pdp-s__price--current">{{ current_variant.price | money }}</span>
        {%- endif -%}
      </div>

      {%- comment -%} Short description {%- endcomment -%}
      {%- if product.metafields.custom.short_description != blank -%}
        <p class="kv-pdp-s__short-desc">{{ product.metafields.custom.short_description }}</p>
      {%- else -%}
        <p class="kv-pdp-s__short-desc">Designed for a lifetime of wear. Each piece is handcrafted in small batches using natural fibres sourced from certified European mills — made to be reached for again and again.</p>
      {%- endif -%}

      {%- comment -%} Tabs: Description | Materials & Care | Shipping {%- endcomment -%}
      <div class="kv-pdp-s__tabs">
        <nav class="kv-pdp-s__tab-nav" role="tablist" aria-label="Product details">
          <button class="kv-pdp-s__tab-btn is-active" role="tab" aria-selected="true" aria-controls="kv-tab-description" id="kv-tab-btn-description">Description</button>
          <button class="kv-pdp-s__tab-btn" role="tab" aria-selected="false" aria-controls="kv-tab-materials" id="kv-tab-btn-materials" style="margin-left:24px;">Materials &amp; Care</button>
          <button class="kv-pdp-s__tab-btn" role="tab" aria-selected="false" aria-controls="kv-tab-shipping" id="kv-tab-btn-shipping" style="margin-left:24px;">Shipping</button>
        </nav>

        <div class="kv-pdp-s__tab-panel is-active" role="tabpanel" id="kv-tab-description" aria-labelledby="kv-tab-btn-description">
          {%- if product.description != blank -%}
            {{ product.description }}
          {%- else -%}
            <p>Considered design, deliberate construction. This piece was conceived without reference to any trend calendar — only to the question of whether it would still feel essential in ten years. We believe it will.</p>
            <p>Cut from premium natural fibres and finished by hand in our partner atelier in Braga, Portugal. Every seam is double-stitched, every edge taped, every detail held to the standard of something you might one day pass on.</p>
          {%- endif -%}
        </div>

        <div class="kv-pdp-s__tab-panel" role="tabpanel" id="kv-tab-materials" aria-labelledby="kv-tab-btn-materials">
          {%- if product.metafields.custom.materials != blank -%}
            {{ product.metafields.custom.materials }}
          {%- else -%}
            <ul>
              <li>100% traceable natural fibres — certified to GOTS or OEKO-TEX Standard 100</li>
              <li>Produced in a certified facility in Portugal with fair working conditions</li>
              <li>Hand wash cold or dry clean only</li>
              <li>Do not tumble dry — lay flat to dry away from direct sunlight</li>
              <li>Cool iron on reverse if needed; do not iron prints or embellishments</li>
            </ul>
            <p>We use no virgin synthetics. Our dyeing processes are waterway-safe and certified low-impact.</p>
          {%- endif -%}
        </div>

        <div class="kv-pdp-s__tab-panel" role="tabpanel" id="kv-tab-shipping" aria-labelledby="kv-tab-btn-shipping">
          <ul>
            <li><strong>Free standard shipping</strong> on all orders over {{ section.settings.free_shipping_threshold | default: '$150' }}</li>
            <li>Standard delivery: 3–5 business days (EU &amp; UK), 5–10 business days (Rest of World)</li>
            <li>Express options available at checkout</li>
          </ul>
          <p><strong>Free returns within 30 days.</strong> Pieces must be unworn with original tags attached. Initiate a return from your order confirmation email or contact us at returns@kova.com.</p>
          <p>We ship in 100% recycled, plastic-free packaging.</p>
        </div>
      </div>

      <div class="kv-divider" style="margin:4px 0;"></div>

      <form id="kv-pdp-s-form" action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
        <input type="hidden" name="id" id="kv-variant-id" value="{{ current_variant.id }}">

        {%- comment -%} Color swatches {%- endcomment -%}
        {%- assign color_option = product.options_with_values | where: "name", "Color" | first -%}
        {%- if color_option -%}
          <div style="margin-bottom:20px;">
            <div class="kv-pdp-s__option-label">
              Color
              <span id="kv-selected-color-label">{{ color_option.selected_value | default: color_option.values.first }}</span>
            </div>
            <div class="kv-pdp-s__swatches">
              {%- for value in color_option.values -%}
                <button
                  type="button"
                  class="kv-pdp-s__swatch{% if forloop.first %} is-active{% endif %}"
                  style="background:{{ value | downcase }};"
                  aria-label="{{ value }}"
                  title="{{ value }}"
                  data-color="{{ value }}"
                  onclick="
                    document.querySelectorAll('.kv-pdp-s__swatch').forEach(s=>s.classList.remove('is-active'));
                    this.classList.add('is-active');
                    document.getElementById('kv-selected-color-label').textContent='{{ value }}';
                  "
                ></button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} Size selector {%- endcomment -%}
        {%- assign size_option = product.options_with_values | where: "name", "Size" | first -%}
        {%- unless size_option -%}
          {%- assign size_option = product.options_with_values | where: "name", "size" | first -%}
        {%- endunless -%}
        {%- if size_option -%}
          <div style="margin-bottom:20px;">
            <div class="kv-pdp-s__sizes-row">
              <span class="kv-pdp-s__option-label">Size</span>
              <button type="button" class="kv-pdp-s__size-guide" onclick="document.getElementById('kv-size-guide').style.display='block';">Size guide</button>
            </div>
            <div class="kv-sizes" id="kv-sizes">
              {%- for variant in product.variants -%}
                {%- assign size_val = variant.options[size_option.position | minus: 1] -%}
                <button
                  type="button"
                  class="kv-size{% unless variant.available %} {% endunless %}"
                  {% unless variant.available %}disabled{% endunless %}
                  data-variant-id="{{ variant.id }}"
                  data-size="{{ size_val }}"
                  aria-label="Size {{ size_val }}{% unless variant.available %} — unavailable{% endunless %}"
                >{{ size_val }}</button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} Qty + Add to cart {%- endcomment -%}
        <div class="kv-pdp-s__qty-row" style="margin-bottom:12px;">
          <div class="kv-pdp-s__qty">
            <button type="button" class="kv-pdp-s__qty-btn" id="kv-qty-minus" aria-label="Decrease quantity">−</button>
            <input
              class="kv-pdp-s__qty-num"
              type="number"
              name="quantity"
              id="kv-qty-input"
              value="1"
              min="1"
              max="10"
              aria-label="Quantity"
            >
            <button type="button" class="kv-pdp-s__qty-btn" id="kv-qty-plus" aria-label="Increase quantity">+</button>
          </div>
          <button
            type="submit"
            class="kv-btn kv-btn--full kv-btn--lg"
            id="kv-atc-btn"
            data-add-to-cart
            {%- unless current_variant.available -%}disabled{%- endunless -%}
          >
            {%- if current_variant.available -%}
              Add to Cart
            {%- else -%}
              Sold Out
            {%- endif -%}
          </button>
        </div>

      </form>

      {%- comment -%} Wishlist {%- endcomment -%}
      <button class="kv-pdp-s__wishlist" data-wishlist aria-label="Save to wishlist">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        Save to Wishlist
      </button>

