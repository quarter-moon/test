{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign on_sale = false -%}
{%- if product.compare_at_price > product.price -%}
  {%- assign on_sale = true -%}
{%- endif -%}

<div class="kv-container" style="padding-top:40px;padding-bottom:80px;">

  <nav style="font-size:12px;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:32px;opacity:0.55;">
    <a href="{{ routes.root_url }}" style="color:var(--color-ink);text-decoration:none;">Home</a>
    &nbsp;/&nbsp;
    {%- if product.collections.first -%}
      <a href="{{ product.collections.first.url }}" style="color:var(--color-ink);text-decoration:none;">{{ product.collections.first.title }}</a>
      &nbsp;/&nbsp;
    {%- endif -%}
    {{ product.title }}
  </nav>

  <div style="display:grid;grid-template-columns:55fr 45fr;gap:64px;align-items:start;">

    {%- comment -%} Images {%- endcomment -%}
    <div>
      {%- if product.featured_image -%}
        <img
          id="kv-pdp-main-img"
          src="{{ product.featured_image | image_url: width: 900 }}"
          alt="{{ product.featured_image.alt | escape | default: product.title }}"
          width="900"
          height="1200"
          loading="eager"
          style="width:100%;display:block;aspect-ratio:3/4;object-fit:cover;background:var(--color-mist);"
        >
      {%- else -%}
        <div style="aspect-ratio:3/4;background:var(--color-mist);display:flex;align-items:center;justify-content:center;">{{ product.vendor }}</div>
      {%- endif -%}

      {%- if product.images.size > 1 -%}
        <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap;">
          {%- for image in product.images limit: 6 -%}
            <button
              type="button"
              onclick="document.getElementById('kv-pdp-main-img').src='{{ image | image_url: width: 900 }}';"
              style="width:80px;aspect-ratio:3/4;overflow:hidden;border:1px solid var(--color-mist);background:none;padding:0;cursor:pointer;"
            >
              <img src="{{ image | image_url: width: 160 }}" alt="{{ image.alt | escape }}" width="80" height="107" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Info {%- endcomment -%}
    <div style="display:flex;flex-direction:column;gap:20px;position:sticky;top:calc(var(--nav-h,80px) + 24px);">

      <span class="t-micro" style="color:var(--color-clay);">{{ product.vendor }}</span>
      <h1 class="t-h1" style="margin:0;">{{ product.title }}</h1>

      <div style="display:flex;align-items:baseline;gap:12px;font-size:20px;font-weight:500;">
        {%- if on_sale -%}
          <span style="color:#b84a4a;">{{ current_variant.price | money }}</span>
          <span style="font-size:15px;text-decoration:line-through;opacity:0.45;">{{ current_variant.compare_at_price | money }}</span>
        {%- else -%}
          <span>{{ current_variant.price | money }}</span>
        {%- endif -%}
      </div>

      {%- if product.description != blank -%}
        <div style="font-size:14px;line-height:1.75;color:#555;">{{ product.description }}</div>
      {%- endif -%}

      {%- form 'product', product, id: 'kv-pdp-form' -%}
        <input type="hidden" name="id" id="kv-variant-id" value="{{ current_variant.id }}">

        {%- comment -%} Options {%- endcomment -%}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div style="margin-bottom:16px;">
              <div style="font-size:11px;letter-spacing:0.1em;text-transform:uppercase;font-weight:500;margin-bottom:10px;">
                {{ option.name }}
              </div>
              {%- if option.name == 'Color' or option.name == 'Colour' -%}
                <div style="display:flex;gap:8px;flex-wrap:wrap;">
                  {%- for value in option.values -%}
                    <button
                      type="button"
                      class="kv-opt-color{% if forloop.first %} is-sel{% endif %}"
                      data-opt="{{ option.position }}"
                      data-val="{{ value | escape }}"
                      title="{{ value }}"
                      aria-label="{{ value }}"
                      style="width:28px;height:28px;border-radius:50%;background:{{ value | downcase }};border:2px solid {% if forloop.first %}var(--color-ink){% else %}transparent{% endif %};cursor:pointer;outline:2px solid var(--color-mist);outline-offset:1px;"
                    ></button>
                  {%- endfor -%}
                </div>
              {%- else -%}
                <div style="display:flex;gap:8px;flex-wrap:wrap;">
                  {%- for value in option.values -%}
                    <button
                      type="button"
                      class="kv-opt-btn{% if forloop.first %} is-sel{% endif %}"
                      data-opt="{{ option.position }}"
                      data-val="{{ value | escape }}"
                      style="min-width:44px;height:44px;padding:0 12px;border:1px solid {% if forloop.first %}var(--color-ink){% else %}var(--color-mist){% endif %};font-family:var(--font-body);font-size:13px;cursor:pointer;background:{% if forloop.first %}var(--color-ink){% else %}var(--color-white){% endif %};color:{% if forloop.first %}var(--color-white){% else %}var(--color-ink){% endif %};"
                    >{{ value }}</button>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <button
          type="submit"
          name="add"
          id="kv-atc"
          class="kv-btn kv-btn--full kv-btn--lg"
          {%- unless current_variant.available %} disabled{%- endunless -%}
        >
          {%- if current_variant.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
        </button>

      {%- endform -%}

      <div style="display:flex;gap:0;border-top:1px solid var(--color-mist);border-bottom:1px solid var(--color-mist);padding:20px 0;">
        <div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:#555;text-align:center;border-right:1px solid var(--color-mist);padding:0 8px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
          Free Shipping
        </div>
        <div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:#555;text-align:center;border-right:1px solid var(--color-mist);padding:0 8px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 14.85-6.85L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-14.85 6.85L3 16"/><path d="M3 21v-5h5"/></svg>
          Free Returns
        </div>
        <div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:#555;text-align:center;padding:0 8px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Secure Checkout
        </div>
      </div>

    </div>

  </div>

</div>

<script>
(function(){
  var variants = {{ product.variants | json }};
  var selected = {};

  {%- for option in product.options_with_values -%}
    selected[{{ option.position }}] = {{ option.selected_value | json }};
  {%- endfor -%}

  function findVariant() {
    return variants.find(function(v) {
      return v.options.every(function(o, i) {
        return o === selected[i + 1];
      });
    });
  }

  function updateVariant() {
    var v = findVariant();
    if (!v) return;
    var idInput = document.getElementById('kv-variant-id');
    var atcBtn = document.getElementById('kv-atc');
    if (idInput) idInput.value = v.id;
    if (atcBtn) {
      atcBtn.disabled = !v.available;
      atcBtn.textContent = v.available ? 'Add to Cart' : 'Sold Out';
    }
    if (v.featured_image) {
      var img = document.getElementById('kv-pdp-main-img');
      if (img) img.src = v.featured_image.src;
    }
  }

  document.querySelectorAll('.kv-opt-btn, .kv-opt-color').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var pos = parseInt(this.dataset.opt);
      var val = this.dataset.val;
      selected[pos] = val;

      var group = document.querySelectorAll('[data-opt="' + pos + '"]');
      group.forEach(function(b) {
        var isSel = b.dataset.val === val;
        b.classList.toggle('is-sel', isSel);
        if (b.classList.contains('kv-opt-btn')) {
          b.style.background = isSel ? 'var(--color-ink)' : 'var(--color-white)';
          b.style.color = isSel ? 'var(--color-white)' : 'var(--color-ink)';
          b.style.borderColor = isSel ? 'var(--color-ink)' : 'var(--color-mist)';
        } else {
          b.style.borderColor = isSel ? 'var(--color-ink)' : 'transparent';
        }
      });
      updateVariant();
    });
  });
})();
</script>

{% schema %}
{
  "name": "Product Detail",
  "settings": []
}
{% endschema %}
