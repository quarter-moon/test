<script>
(function () {
  // ─── Vertical thumb strip ───────────────────────────────────────
  var thumbs = document.querySelectorAll('.kv-pdp-s__thumb');
  var mainImg = document.getElementById('kv-main-img');
  var allImages = [
    {%- for image in product.images limit: 6 -%}
      { src: '{{ image | image_url: width: 1000 }}', alt: '{{ image.alt | escape | default: product.title }}' }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ];

  thumbs.forEach(function (thumb) {
    thumb.addEventListener('click', function () {
      var idx = parseInt(this.getAttribute('data-index'), 10);
      thumbs.forEach(function (t) { t.classList.remove('is-active'); });
      this.classList.add('is-active');
      if (mainImg && allImages[idx]) {
        mainImg.style.opacity = '0';
        setTimeout(function () {
          mainImg.src = allImages[idx].src;
          mainImg.alt = allImages[idx].alt;
          mainImg.style.opacity = '1';
        }, 150);
      }
    });
  });

  // ─── Mobile carousel ────────────────────────────────────────────
  var carousel = document.getElementById('kv-carousel');
  var track = document.getElementById('kv-carousel-track');
  var dots = document.querySelectorAll('.kv-pdp-s__dot');
  var currentSlide = 0;
  var totalSlides = allImages.length || 1;

  function goToSlide(n) {
    currentSlide = Math.max(0, Math.min(n, totalSlides - 1));
    if (track) track.style.transform = 'translateX(-' + (currentSlide * 100) + '%)';
    dots.forEach(function (d, i) {
      d.classList.toggle('is-active', i === currentSlide);
      d.setAttribute('aria-selected', i === currentSlide ? 'true' : 'false');
    });
  }

  dots.forEach(function (dot) {
    dot.addEventListener('click', function () {
      goToSlide(parseInt(this.getAttribute('data-index'), 10));
    });
  });

  // Touch swipe
  if (carousel) {
    var startX = 0;
    carousel.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; }, { passive: true });
    carousel.addEventListener('touchend', function (e) {
      var diff = startX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) goToSlide(currentSlide + (diff > 0 ? 1 : -1));
    }, { passive: true });
  }

  // ─── Size variant selection ──────────────────────────────────────
  var sizeButtons = document.querySelectorAll('#kv-sizes .kv-size');
  var variantInput = document.getElementById('kv-variant-id');
  var atcBtn = document.getElementById('kv-atc-btn');

  sizeButtons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (this.disabled) return;
      sizeButtons.forEach(function (b) { b.classList.remove('is-active'); });
      this.classList.add('is-active');
      var vid = this.getAttribute('data-variant-id');
      if (variantInput) variantInput.value = vid;
      if (atcBtn) { atcBtn.disabled = false; atcBtn.textContent = 'Add to Cart'; }
    });
  });

  // ─── Quantity stepper ────────────────────────────────────────────
  var qtyInput = document.getElementById('kv-qty-input');
  document.getElementById('kv-qty-minus') && document.getElementById('kv-qty-minus').addEventListener('click', function () {
    if (qtyInput && parseInt(qtyInput.value) > 1) qtyInput.value = parseInt(qtyInput.value) - 1;
  });
  document.getElementById('kv-qty-plus') && document.getElementById('kv-qty-plus').addEventListener('click', function () {
    if (qtyInput && parseInt(qtyInput.value) < 10) qtyInput.value = parseInt(qtyInput.value) + 1;
  });

  // ─── Product tabs ─────────────────────────────────────────────────
  var tabBtns = document.querySelectorAll('.kv-pdp-s__tab-btn');
  var tabPanels = document.querySelectorAll('.kv-pdp-s__tab-panel');

  tabBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var target = this.getAttribute('aria-controls');
      tabBtns.forEach(function (b) { b.classList.remove('is-active'); b.setAttribute('aria-selected', 'false'); });
      tabPanels.forEach(function (p) { p.classList.remove('is-active'); });
      this.classList.add('is-active');
      this.setAttribute('aria-selected', 'true');
      var panel = document.getElementById(target);
      if (panel) panel.classList.add('is-active');
    });
  });

  // ─── Wishlist toggle ─────────────────────────────────────────────
  var wishlistBtn = document.querySelector('.kv-pdp-s__wishlist[data-wishlist]');
  if (wishlistBtn) {
    wishlistBtn.addEventListener('click', function () {
      this.classList.toggle('is-on');
      var isOn = this.classList.contains('is-on');
      this.querySelector('svg').setAttribute('fill', isOn ? 'currentColor' : 'none');
      this.childNodes[this.childNodes.length - 1].textContent = isOn ? ' Saved' : ' Save to Wishlist';
    });
  }
})();
</script>

