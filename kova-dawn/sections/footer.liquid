<footer class="kv-footer">
  <div class="kv-container">
    <div class="kv-footer__cols">

      {%- comment -%} Brand column {%- endcomment -%}
      <div class="kv-footer__col">
        <div class="kv-footer__brand-name">{{ shop.name | upcase }}</div>
        <div class="kv-footer__brand-desc">{{ section.settings.brand_desc }}</div>
        <div class="kv-footer__social">
          {%- if section.settings.instagram != blank -%}
            <a href="{{ section.settings.instagram }}" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.pinterest != blank -%}
            <a href="{{ section.settings.pinterest }}" aria-label="Pinterest">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 22s4-5 4-10"/><path d="M12 8a3 3 0 0 1 3 3c0 2-1.5 3.5-3 4"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.tiktok != blank -%}
            <a href="{{ section.settings.tiktok }}" aria-label="TikTok">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Shop column {%- endcomment -%}
      <div class="kv-footer__col">
        <div class="kv-footer__heading">Shop</div>
        <ul class="kv-footer__list">
          <li><a href="/collections/new-in">New arrivals</a></li>
          <li><a href="/collections/clothing">Clothing</a></li>
          <li><a href="/collections/accessories">Accessories</a></li>
          <li><a href="/collections/sale">Sale</a></li>
        </ul>
      </div>

      {%- comment -%} Help column {%- endcomment -%}
      <div class="kv-footer__col">
        <div class="kv-footer__heading">Help</div>
        <ul class="kv-footer__list">
          <li><a href="/pages/contact">Customer service</a></li>
          <li><a href="/policies/shipping-policy">Shipping</a></li>
          <li><a href="/policies/refund-policy">Returns</a></li>
          <li><a href="/pages/size-guide">Size guide</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
        </ul>
      </div>

      {%- comment -%} Newsletter column {%- endcomment -%}
      <div class="kv-footer__col">
        <div class="kv-footer__heading">Stay in touch</div>
        <div style="font-size:14px;opacity:0.8;line-height:1.6;">{{ section.settings.newsletter_desc }}</div>
        {%- form 'customer', id: 'FooterNewsletter', class: 'kv-footer__subscribe' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" placeholder="Enter your email" required autocomplete="email">
          <button type="submit" aria-label="Subscribe">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </button>
        {%- endform -%}
      </div>

    </div>

    <div class="kv-footer__bottom">
      <span class="l">© {{ 'now' | date: '%Y' }} {{ shop.name | upcase }}. All rights reserved.</span>
      <div class="kv-footer__pay">
        <span class="pay">VISA</span>
        <span class="pay">MC</span>
        <span class="pay">AMEX</span>
        <span class="pay">PAYPAL</span>
        <span class="pay">APPLE PAY</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "textarea",
      "id": "brand_desc",
      "label": "Brand description",
      "default": "A wardrobe of considered essentials, designed in Copenhagen and crafted across Europe."
    },
    {
      "type": "text",
      "id": "newsletter_desc",
      "label": "Newsletter description",
      "default": "Quietly considered new arrivals, delivered monthly."
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "pinterest",
      "label": "Pinterest URL"
    },
    {
      "type": "url",
      "id": "tiktok",
      "label": "TikTok URL"
    }
  ]
}
{% endschema %}
