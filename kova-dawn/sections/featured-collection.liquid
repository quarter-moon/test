{%- assign collection = collections[section.settings.collection] -%}

<section class="kv-section">
  <div class="kv-container">
    <header class="kv-section-head">
      <div class="kv-section-head__title">
        {%- if section.settings.label != blank -%}
          <span class="t-micro" style="color:var(--color-clay);">{{ section.settings.label }}</span>
        {%- endif -%}
        <h2 class="t-h1">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.view_all_label != blank -%}
        <a class="kv-btn kv-btn--ghost" href="{{ collection.url | default: '/collections/all' }}">
          {{ section.settings.view_all_label }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      {%- endif -%}
    </header>

    <div class="kv-grid">
      {%- if collection != blank -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          {%- render 'product-card', product: product -%}
        {%- else -%}
          {%- for i in (1..section.settings.products_to_show) -%}
            <article class="kv-card">
              <div class="kv-card__img-wrap kv-ph">KOVA</div>
              <div class="kv-card__info">
                <span class="kv-card__vendor">Collection</span>
                <span class="kv-card__name">Product {{ i }}</span>
                <div class="kv-card__price"><span>$000</span></div>
              </div>
            </article>
          {%- endfor -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.products_to_show) -%}
          <article class="kv-card">
            <div class="kv-card__img-wrap kv-ph">KOVA</div>
            <div class="kv-card__info">
              <span class="kv-card__vendor">Category</span>
              <span class="kv-card__name">Placeholder Product {{ i }}</span>
              <div class="kv-card__price"><span>$000</span></div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "New In · Resort 26"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The latest arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection",
      "settings": {
        "label": "New In · Resort 26",
        "heading": "The latest arrivals",
        "products_to_show": 4,
        "view_all_label": "View all"
      }
    }
  ]
}
{% endschema %}
