{%- assign items = section.settings.text | split: '|' -%}
<div class="kv-marquee">
  <div class="kv-marquee__track">
    {%- for item in items -%}
      <span class="kv-marquee__item">{{ item | strip }}</span>
    {%- endfor -%}
    {%- for item in items -%}
      <span class="kv-marquee__item">{{ item | strip }}</span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee Strip",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Marquee text (separate items with |)",
      "default": "New Arrivals|Free Returns|Sustainable Materials|Made in Europe|Shipping Worldwide"
    }
  ],
  "presets": [
    {
      "name": "Marquee Strip",
      "settings": {
        "text": "New Arrivals|Free Returns|Sustainable Materials|Made in Europe|Shipping Worldwide"
      }
    }
  ]
}
{% endschema %}
