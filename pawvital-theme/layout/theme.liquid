<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ page_description | escape }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">
  {%- else -%}
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
  {%- endif -%}

  <title>
    {%- if page_title == shop.name -%}
      {{ shop.name }} — Pet Health & Wellness
    {%- else -%}
      {{ page_title }} — {{ shop.name }}
    {%- endif -%}
  </title>

  {{ content_for_header }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">

  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>
<body class="template-{{ template.name }}">

  {%- section 'announcement-bar' -%}
  {%- section 'header' -%}

  <main id="main-content" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {%- section 'footer' -%}

  {%- render 'cart-drawer' -%}

  <script>
    window.shopUrl = {{ shop.url | json }};
    window.cartStrings = {
      error: {{ 'sections.cart.cart_error' | t | json }},
      quantityError: {{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' | json }}
    };
    window.moneyFormat = {{ shop.money_format | json }};
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
