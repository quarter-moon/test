<section class="trust">
  <div class="wrap">
    <div class="trust-row">
      {%- for block in section.blocks -%}
        <div class="trust-cell" {{ block.shopify_attributes }}>
          <div class="tc-ico">
            {%- render 'icon', name: block.settings.icon -%}
          </div>
          <div>
            <b>{{ block.settings.heading }}</b>
            <span>{{ block.settings.subtext }}</span>
          </div>
        </div>
      {%- else -%}
        <div class="trust-cell">
          <div class="tc-ico">{%- render 'icon', name: 'flask' -%}</div>
          <div><b>Vet-formulated</b><span>By licensed DVMs</span></div>
        </div>
        <div class="trust-cell">
          <div class="tc-ico">{%- render 'icon', name: 'leaf' -%}</div>
          <div><b>Clean ingredients</b><span>No fillers or junk</span></div>
        </div>
        <div class="trust-cell">
          <div class="tc-ico">{%- render 'icon', name: 'recycle' -%}</div>
          <div><b>Cruelty-free</b><span>Never tested on animals</span></div>
        </div>
        <div class="trust-cell">
          <div class="tc-ico">{%- render 'icon', name: 'truck' -%}</div>
          <div><b>Free shipping</b><span>On orders over $49</span></div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust strip",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "flask",   "label": "Flask (Vet)" },
            { "value": "leaf",    "label": "Leaf (Natural)" },
            { "value": "recycle", "label": "Recycle (Eco)" },
            { "value": "truck",   "label": "Truck (Shipping)" },
            { "value": "shield",  "label": "Shield (Safety)" },
            { "value": "check",   "label": "Check" }
          ],
          "default": "flask"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Vet-formulated"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "By licensed DVMs"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust strip",
      "blocks": [
        { "type": "trust_item", "settings": { "icon": "flask",   "heading": "Vet-formulated",   "subtext": "By licensed DVMs" } },
        { "type": "trust_item", "settings": { "icon": "leaf",    "heading": "Clean ingredients", "subtext": "No fillers or junk" } },
        { "type": "trust_item", "settings": { "icon": "recycle", "heading": "Cruelty-free",      "subtext": "Never tested on animals" } },
        { "type": "trust_item", "settings": { "icon": "truck",   "heading": "Free shipping",     "subtext": "On orders over $49" } }
      ]
    }
  ]
}
{% endschema %}
