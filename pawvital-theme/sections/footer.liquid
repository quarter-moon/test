<footer class="site-footer" role="contentinfo">
  <div class="wrap">
    <div class="footer-top">

      <!-- Brand column -->
      <div class="footer-brand">
        <div class="fb-logo">
          <img src="{{ 'favicon.svg' | asset_url }}" alt="{{ shop.name }}" width="40" height="40" loading="lazy">
          <span class="wm-name">
            {%- if shop.name == 'PawVital' -%}
              <span class="paw">Paw</span><span class="vital">Vital</span>
            {%- else -%}
              {{ shop.name }}
            {%- endif -%}
          </span>
        </div>
        <p>{{ section.settings.tagline | default: 'Vet-formulated wellness for the pets who give us everything. Real ingredients, real science, real tail wags.' }}</p>
        <div class="footer-social">
          {%- if section.settings.instagram_url != blank -%}
            <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
              {%- render 'icon', name: 'instagram' -%}
            </a>
          {%- endif -%}
          {%- if section.settings.facebook_url != blank -%}
            <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">
              {%- render 'icon', name: 'facebook' -%}
            </a>
          {%- endif -%}
          {%- if section.settings.tiktok_url != blank -%}
            <a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok">
              {%- render 'icon', name: 'tiktok' -%}
            </a>
          {%- endif -%}
          {%- if section.settings.youtube_url != blank -%}
            <a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube">
              {%- render 'icon', name: 'youtube' -%}
            </a>
          {%- endif -%}
          {%- if section.settings.instagram_url == blank and section.settings.facebook_url == blank -%}
            <a href="#" aria-label="Instagram">{%- render 'icon', name: 'instagram' -%}</a>
            <a href="#" aria-label="Facebook">{%- render 'icon', name: 'facebook' -%}</a>
            <a href="#" aria-label="TikTok">{%- render 'icon', name: 'tiktok' -%}</a>
            <a href="#" aria-label="YouTube">{%- render 'icon', name: 'youtube' -%}</a>
          {%- endif -%}
        </div>
      </div>

      <!-- Link columns -->
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            <h5>{{ block.settings.heading }}</h5>
            {%- if block.settings.menu != blank -%}
              {%- assign menu = linklists[block.settings.menu] -%}
              {%- for link in menu.links -%}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {%- endfor -%}
            {%- else -%}
              <a href="/collections/supplements">Supplements</a>
              <a href="/collections/food-treats">Food &amp; Treats</a>
              <a href="/collections/wellness">Wellness</a>
              <a href="/collections/grooming">Grooming</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="footer-col">
          <h5>Shop</h5>
          <a href="/collections/supplements">Supplements</a>
          <a href="/collections/food-treats">Food &amp; Treats</a>
          <a href="/collections/wellness">Wellness</a>
          <a href="/collections/grooming">Grooming</a>
          <a href="/collections/bundles">Bundles</a>
          <a href="/collections/sale">Sale</a>
        </div>
        <div class="footer-col">
          <h5>Learn</h5>
          <a href="/pages/our-science">Our Science</a>
          <a href="/pages/ingredients">Ingredient Glossary</a>
          <a href="/blogs/news">The PawVital Blog</a>
          <a href="/pages/dosage-guide">Dosage Guide</a>
          <a href="/pages/reviews">Reviews</a>
        </div>
        <div class="footer-col">
          <h5>Support</h5>
          <a href="/pages/contact">Contact Us</a>
          <a href="/policies/shipping-policy">Shipping &amp; Returns</a>
          <a href="/pages/subscriptions">Subscriptions</a>
          <a href="/pages/track-order">Track Order</a>
          <a href="/pages/faq">FAQ</a>
        </div>
      {%- endfor -%}

    </div><!-- /footer-top -->

    <div class="footer-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}, Inc. &middot; Made for happy, healthy pets.</span>
      <div class="footer-pay">
        <span>VISA</span>
        <span>MC</span>
        <span>AMEX</span>
        <span>PAYPAL</span>
        <span>PAY</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "blocks": [
    {
      "type": "link_list",
      "name": "Link list",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Brand tagline",
      "default": "Vet-formulated wellness for the pets who give us everything. Real ingredients, real science, real tail wags."
    },
    {
      "type": "header",
      "content": "Social media"
    },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "facebook_url",  "label": "Facebook URL"  },
    { "type": "url", "id": "tiktok_url",    "label": "TikTok URL"    },
    { "type": "url", "id": "youtube_url",   "label": "YouTube URL"   }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "link_list", "settings": { "heading": "Shop",    "menu": "footer-shop" } },
        { "type": "link_list", "settings": { "heading": "Learn",   "menu": "footer-learn" } },
        { "type": "link_list", "settings": { "heading": "Support", "menu": "footer-support" } }
      ]
    }
  ]
}
{% endschema %}
