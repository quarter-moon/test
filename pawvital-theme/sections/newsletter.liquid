<section class="section wrap" style="padding-top:0;">
  <div class="news">
    <div class="eyebrow" style="color:var(--accent);">
      {{ section.settings.eyebrow | default: 'Join the pack' }}
    </div>
    <h2>{{ section.settings.heading | default: 'Get 10% off your first order' }}</h2>
    <p>{{ section.settings.subtext | default: 'Wellness tips, new drops, and members-only deals — straight to your inbox. No spam, just good things for good pets.' }}</p>

    {%- form 'customer', id: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="news-form">
        <input type="email"
               name="contact[email]"
               id="newsletter-email"
               placeholder="{{ section.settings.placeholder | default: 'you@email.com' }}"
               aria-label="Email address"
               autocomplete="email"
               required>
        <button type="submit" class="btn btn-primary">
          {{ section.settings.btn_label | default: 'Get my 10%' }}
        </button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="news-fine" style="color:var(--brand);font-weight:700;" role="alert">
          🎉 You're in! Check your inbox for your discount code.
        </p>
      {%- elsif form.errors -%}
        <p class="news-fine" style="color:var(--accent);" role="alert">
          {{ form.errors.translated_fields.email | capitalize }}
          {{ form.errors.messages.email }}
        </p>
      {%- else -%}
        <p class="news-fine">{{ section.settings.fine_print | default: 'By signing up you agree to receive email marketing. Unsubscribe anytime.' }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Join the pack"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get 10% off your first order"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Wellness tips, new drops, and members-only deals — straight to your inbox. No spam, just good things for good pets."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "you@email.com"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button label",
      "default": "Get my 10%"
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Fine print",
      "default": "By signing up you agree to receive email marketing. Unsubscribe anytime."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
