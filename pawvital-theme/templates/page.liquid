<article class="page-content wrap" style="max-width:780px;margin:60px auto;padding:0 20px;">
  <h1 style="font-family:var(--font-head);font-size:clamp(28px,5vw,44px);color:var(--ink);margin:0 0 24px;">{{ page.title }}</h1>
  <div class="rte" style="color:var(--ink);line-height:1.75;font-size:17px;">
    {{ page.content }}
  </div>
</article>
