<div class="wrap" style="padding:60px 20px;">
  <div style="max-width:900px;margin:0 auto;">
    <h1 style="font-family:var(--font-head);font-size:clamp(28px,5vw,48px);color:var(--ink);margin:0 0 8px;">{{ blog.title }}</h1>
    <p style="color:var(--muted);margin:0 0 48px;">Tips, research, and wellness stories for pet parents.</p>

    {%- paginate blog.articles by 10 -%}
    <div style="display:grid;gap:40px;">
      {%- for article in blog.articles -%}
        <article style="display:grid;grid-template-columns:1fr 2fr;gap:28px;align-items:start;" class="blog-card">
          <a href="{{ article.url }}" style="display:block;border-radius:var(--r-lg);overflow:hidden;aspect-ratio:4/3;background:var(--mint);">
            {%- if article.image -%}
              <img src="{{ article.image | image_url: width: 600 }}"
                   alt="{{ article.image.alt | escape }}"
                   width="600" height="450"
                   loading="lazy"
                   style="width:100%;height:100%;object-fit:cover;">
            {%- else -%}
              <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--brand);opacity:.4;">
                {%- render 'icon', name: 'paw' -%}
              </div>
            {%- endif -%}
          </a>
          <div>
            <div style="font-size:13px;color:var(--muted);margin-bottom:10px;">
              {{ article.published_at | date: '%B %d, %Y' }}
              {%- unless article.tags == empty -%}
                &nbsp;&middot;&nbsp;
                {%- for tag in article.tags limit:2 -%}
                  <span style="text-transform:capitalize;">{{ tag }}</span>{%- unless forloop.last -%}, {%- endunless -%}
                {%- endfor -%}
              {%- endunless -%}
            </div>
            <h2 style="font-family:var(--font-head);font-size:22px;font-weight:800;color:var(--ink);margin:0 0 10px;line-height:1.3;">
              <a href="{{ article.url }}" style="color:inherit;text-decoration:none;">{{ article.title }}</a>
            </h2>
            {%- if article.excerpt.size > 0 -%}
              <p style="color:var(--muted);line-height:1.6;margin:0 0 16px;">{{ article.excerpt | strip_html | truncate: 160 }}</p>
            {%- endif -%}
            <a href="{{ article.url }}" style="color:var(--brand);font-weight:600;font-size:15px;text-decoration:none;">
              Read more {%- render 'icon', name: 'arrow-right' -%}
            </a>
          </div>
        </article>
        {%- unless forloop.last -%}
          <hr style="border:none;border-top:1px solid var(--border);">
        {%- endunless -%}
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <div style="display:flex;justify-content:center;gap:8px;margin-top:48px;">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" class="btn">{{ 'general.pagination.previous' | t }}</a>
        {%- endif -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="btn btn-primary">{{ 'general.pagination.next' | t }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
  {%- endpaginate -%}
</div>
