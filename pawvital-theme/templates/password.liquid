<div style="text-align:center;padding:60px 24px;max-width:480px;margin:0 auto;">
  <a href="{{ routes.root_url }}" class="brand-logo" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;margin-bottom:40px;">
    <img src="{{ 'favicon.svg' | asset_url }}" alt="{{ shop.name }}" width="44" height="44">
    <span class="wordmark">
      <span class="wm-name"><span class="paw">Paw</span><span class="vital">Vital</span></span>
    </span>
  </a>

  <h1 style="font-family:var(--font-head);font-size:clamp(28px,5vw,44px);color:var(--ink);margin:0 0 12px;">
    {{ 'general.password_page.login_form_heading' | t }}
  </h1>
  <p style="color:var(--muted);margin-bottom:32px;">Opening soon — enter the password to get early access.</p>

  {% form 'storefront_password' %}
    {%- if form.errors -%}
      <p style="color:#c0392b;margin-bottom:16px;">{{ form.errors | default_errors }}</p>
    {%- endif -%}
    <div style="display:flex;gap:8px;">
      <input type="password"
             name="password"
             id="password"
             placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
             style="flex:1;padding:12px 16px;border:1.5px solid var(--border);border-radius:var(--r-md);font-size:16px;outline:none;"
             required
             aria-label="{{ 'general.password_page.login_form_password_label' | t }}">
      <button type="submit" class="btn btn-primary">
        {{ 'general.password_page.login_form_submit' | t }}
      </button>
    </div>
  {% endform %}
</div>
