<div class="wrap" style="padding:60px 20px;">
  <div style="max-width:1100px;margin:0 auto;">
    <h1 style="font-family:var(--font-head);font-size:clamp(28px,5vw,44px);color:var(--ink);margin:0 0 8px;">Collections</h1>
    <p style="color:var(--muted);margin:0 0 40px;">Browse every part of the PawVital wellness range.</p>

    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:24px;">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" style="display:block;text-decoration:none;border-radius:var(--r-lg);overflow:hidden;border:1.5px solid var(--border);background:#fff;transition:transform .2s,box-shadow .2s;">
          <div style="aspect-ratio:4/3;background:var(--mint);overflow:hidden;">
            {%- if collection.featured_image -%}
              <img src="{{ collection.featured_image | image_url: width: 480 }}"
                   alt="{{ collection.title | escape }}"
                   width="480" height="360"
                   loading="lazy"
                   style="width:100%;height:100%;object-fit:cover;">
            {%- else -%}
              <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--brand);opacity:.35;">
                {%- render 'icon', name: 'paw' -%}
              </div>
            {%- endif -%}
          </div>
          <div style="padding:18px 20px;">
            <h2 style="font-family:var(--font-head);font-size:18px;font-weight:800;color:var(--ink);margin:0 0 4px;">{{ collection.title }}</h2>
            <span style="font-size:13px;color:var(--muted);">{{ collection.all_products_count }} products</span>
          </div>
        </a>
      {%- else -%}
        <p style="color:var(--muted);">No collections found.</p>
      {%- endfor -%}
    </div>
  </div>
</div>
