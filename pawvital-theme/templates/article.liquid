<div class="wrap" style="padding:60px 20px;">
  <div style="max-width:720px;margin:0 auto;">

    <div style="margin-bottom:32px;">
      <a href="{{ blog.url }}" style="color:var(--brand);font-size:14px;font-weight:600;text-decoration:none;">
        {%- render 'icon', name: 'chevron' -%} {{ blog.title }}
      </a>
    </div>

    <div style="font-size:13px;color:var(--muted);margin-bottom:12px;">
      {{ article.published_at | date: '%B %d, %Y' }}
      {%- unless article.tags == empty -%}
        &nbsp;&middot;&nbsp;
        {%- for tag in article.tags limit:3 -%}
          <span style="background:var(--mint);color:var(--brand);padding:2px 8px;border-radius:var(--r-pill);font-weight:600;font-size:12px;text-transform:capitalize;">{{ tag }}</span>
        {%- endfor -%}
      {%- endunless -%}
    </div>

    <h1 style="font-family:var(--font-head);font-size:clamp(26px,5vw,44px);color:var(--ink);margin:0 0 24px;line-height:1.2;">{{ article.title }}</h1>

    {%- if article.image -%}
      <div style="border-radius:var(--r-lg);overflow:hidden;margin-bottom:36px;aspect-ratio:16/9;">
        <img src="{{ article.image | image_url: width: 1200 }}"
             alt="{{ article.image.alt | escape }}"
             width="1200" height="675"
             loading="eager"
             style="width:100%;height:100%;object-fit:cover;">
      </div>
    {%- endif -%}

    <div class="rte" style="font-size:17px;line-height:1.8;color:var(--ink);">
      {{ article.content }}
    </div>

    <hr style="border:none;border-top:1px solid var(--border);margin:48px 0;">

    <div style="display:flex;align-items:center;gap:16px;">
      <div style="width:48px;height:48px;border-radius:50%;background:var(--mint);display:flex;align-items:center;justify-content:center;color:var(--brand);">
        {%- render 'icon', name: 'user' -%}
      </div>
      <div>
        <div style="font-weight:700;color:var(--ink);">{{ article.author }}</div>
        <div style="font-size:13px;color:var(--muted);">PawVital Team</div>
      </div>
    </div>

  </div>
</div>
