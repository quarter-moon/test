<div class="wrap" style="padding:60px 20px;max-width:900px;margin:0 auto;">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:40px;flex-wrap:wrap;gap:16px;">
    <div>
      <h1 style="font-family:var(--font-head);font-size:clamp(24px,4vw,36px);color:var(--ink);margin:0 0 4px;">
        Welcome back, {{ customer.first_name }}
      </h1>
      <p style="color:var(--muted);margin:0;">{{ customer.email }}</p>
    </div>
    <a href="{{ routes.account_logout_url }}" class="btn">Sign out</a>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:48px;">
    <a href="{{ routes.account_addresses_url }}" style="background:#fff;border:1.5px solid var(--border);border-radius:var(--r-lg);padding:24px;text-decoration:none;display:flex;align-items:center;gap:16px;transition:border-color .2s;" onmouseover="this.style.borderColor='var(--brand)'" onmouseout="this.style.borderColor='var(--border)'">
      <div style="width:44px;height:44px;background:var(--mint);border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;color:var(--brand);">{%- render 'icon', name: 'user' -%}</div>
      <div>
        <div style="font-weight:700;color:var(--ink);">Addresses</div>
        <div style="font-size:13px;color:var(--muted);">{{ customer.addresses_count }} saved</div>
      </div>
    </a>
    <div style="background:#fff;border:1.5px solid var(--border);border-radius:var(--r-lg);padding:24px;display:flex;align-items:center;gap:16px;">
      <div style="width:44px;height:44px;background:var(--peach);border-radius:var(--r-md);display:flex;align-items:center;justify-content:center;color:var(--accent);">{%- render 'icon', name: 'bag' -%}</div>
      <div>
        <div style="font-weight:700;color:var(--ink);">Orders</div>
        <div style="font-size:13px;color:var(--muted);">{{ customer.orders_count }} total</div>
      </div>
    </div>
  </div>

  <h2 style="font-family:var(--font-head);font-size:22px;color:var(--ink);margin:0 0 20px;">Order history</h2>
  {%- if customer.orders.size == 0 -%}
    <div style="background:var(--paper);border-radius:var(--r-lg);padding:40px;text-align:center;">
      <p style="color:var(--muted);margin:0 0 20px;">No orders yet. When you make your first purchase, it'll appear here.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary">Shop now</a>
    </div>
  {%- else -%}
    <div style="overflow-x:auto;">
      <table style="width:100%;border-collapse:collapse;font-size:15px;">
        <thead>
          <tr style="border-bottom:2px solid var(--border);">
            <th style="text-align:left;padding:12px 0;font-weight:700;color:var(--ink);">Order</th>
            <th style="text-align:left;padding:12px 16px;font-weight:700;color:var(--ink);">Date</th>
            <th style="text-align:left;padding:12px 16px;font-weight:700;color:var(--ink);">Payment</th>
            <th style="text-align:left;padding:12px 16px;font-weight:700;color:var(--ink);">Fulfillment</th>
            <th style="text-align:right;padding:12px 0;font-weight:700;color:var(--ink);">Total</th>
          </tr>
        </thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr style="border-bottom:1px solid var(--border);">
              <td style="padding:16px 0;">
                <a href="{{ order.customer_url }}" style="color:var(--brand);font-weight:600;">{{ order.name }}</a>
              </td>
              <td style="padding:16px;color:var(--muted);">{{ order.created_at | date: '%b %d, %Y' }}</td>
              <td style="padding:16px;">
                <span style="background:var(--mint);color:var(--brand-deep);padding:3px 10px;border-radius:var(--r-pill);font-size:12px;font-weight:600;">{{ order.financial_status | capitalize }}</span>
              </td>
              <td style="padding:16px;">
                <span style="background:var(--paper);color:var(--muted);padding:3px 10px;border-radius:var(--r-pill);font-size:12px;font-weight:600;">{{ order.fulfillment_status | default: 'Unfulfilled' | capitalize }}</span>
              </td>
              <td style="padding:16px 0;text-align:right;font-weight:700;color:var(--ink);">{{ order.total_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  {%- endif -%}
</div>
