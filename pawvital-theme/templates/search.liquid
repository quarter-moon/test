<div class="wrap" style="padding:60px 20px;">
  <h1 style="font-family:var(--font-head);font-size:clamp(24px,4vw,40px);color:var(--ink);margin:0 0 8px;">
    {%- if search.performed -%}
      Search results for &ldquo;{{ search.terms | escape }}&rdquo;
    {%- else -%}
      Search
    {%- endif -%}
  </h1>

  <form action="{{ routes.search_url }}" method="get" role="search" style="margin:24px 0 40px;max-width:560px;">
    <input type="hidden" name="type" value="product">
    <div style="display:flex;gap:8px;">
      <input type="search"
             name="q"
             value="{{ search.terms | escape }}"
             placeholder="{{ 'general.search.placeholder' | t }}"
             aria-label="{{ 'general.search.placeholder' | t }}"
             style="flex:1;padding:12px 16px;border:1.5px solid var(--border);border-radius:var(--r-md);font-size:16px;font-family:var(--font-body);">
      <button type="submit" class="btn btn-primary">{{ 'general.search.submit' | t }}</button>
    </div>
  </form>

  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <p style="color:var(--muted);font-size:18px;">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
    {%- else -%}
      <p style="color:var(--muted);margin-bottom:32px;">{{ search.results_count }} result{%- if search.results_count != 1 -%}s{%- endif -%}</p>
      <div class="prod-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:24px;">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {%- render 'product-card', product: item -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</div>
