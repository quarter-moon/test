{% layout 'gift_card' %}

<div class="wrap" style="text-align:center;padding:60px 20px;">
  <a href="{{ routes.root_url }}" class="brand-logo" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;margin-bottom:40px;">
    <img src="{{ 'favicon.svg' | asset_url }}" alt="{{ shop.name }}" width="44" height="44">
    <span class="wordmark">
      <span class="wm-name"><span class="paw">Paw</span><span class="vital">Vital</span></span>
    </span>
  </a>

  <div style="background:#fff;border-radius:var(--r-lg);box-shadow:var(--shadow-md);padding:40px;max-width:480px;margin:0 auto;">
    <div style="background:linear-gradient(135deg,var(--brand) 0%,var(--brand-deep) 100%);border-radius:var(--r-md);padding:32px;color:#fff;margin-bottom:24px;">
      <div style="font-size:13px;font-weight:600;letter-spacing:.08em;opacity:.8;margin-bottom:8px;">GIFT CARD</div>
      <div style="font-family:var(--font-head);font-size:48px;font-weight:900;">{{ gift_card.initial_value | money_without_currency }}</div>
      <div style="font-size:13px;opacity:.7;margin-top:4px;">{{ shop.currency }}</div>
    </div>

    {%- if gift_card.enabled == false or gift_card.expired -%}
      <p style="color:#c0392b;font-weight:600;">This gift card has expired or been disabled.</p>
    {%- else -%}
      <div style="margin-bottom:16px;">
        <div style="font-size:13px;color:var(--muted);margin-bottom:4px;">Remaining balance</div>
        <div style="font-family:var(--font-head);font-size:28px;font-weight:800;color:var(--ink);">
          {{ gift_card.balance | money }}
        </div>
      </div>

      <div style="background:var(--paper);border-radius:var(--r-md);padding:16px;margin-bottom:20px;">
        <div style="font-size:12px;color:var(--muted);margin-bottom:8px;">Gift card code</div>
        <div id="gift-card-code" style="font-family:monospace;font-size:18px;letter-spacing:.15em;color:var(--ink);font-weight:700;">
          {{ gift_card.code | format_code }}
        </div>
      </div>

      {% if gift_card.pass_url %}
        <a href="{{ gift_card.pass_url }}" class="btn btn-primary btn-block" style="margin-bottom:10px;">
          Add to Apple Wallet
        </a>
      {% endif %}

      <a href="{{ routes.root_url }}" class="btn btn-block">Shop now</a>
    {%- endif -%}
  </div>

  {%- if gift_card.expires_on -%}
    <p style="color:var(--muted);font-size:14px;margin-top:16px;">
      Expires {{ gift_card.expires_on | date: '%B %d, %Y' }}
    </p>
  {%- endif -%}
</div>
