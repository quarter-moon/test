{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "860px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        { "slug": "green",       "color": "#5cb800", "name": "Green" },
        { "slug": "green-dark",  "color": "#4a9600", "name": "Green Dark" },
        { "slug": "green-deep",  "color": "#2d6315", "name": "Green Deep" },
        { "slug": "green-deep2", "color": "#3a7d1c", "name": "Green Deep 2" },
        { "slug": "green-light", "color": "#f0f9e6", "name": "Green Light" },
        { "slug": "white",       "color": "#ffffff", "name": "White" },
        { "slug": "bg",          "color": "#ffffff", "name": "Background" },
        { "slug": "surface",     "color": "#f7f8f9", "name": "Surface" },
        { "slug": "surface2",    "color": "#eef0f2", "name": "Surface 2" },
        { "slug": "border",      "color": "#e2e5e9", "name": "Border" },
        { "slug": "text",        "color": "#1a1d22", "name": "Text" },
        { "slug": "text-muted",  "color": "#6b7280", "name": "Text Muted" },
        { "slug": "text-dim",    "color": "#b0b7c3", "name": "Text Dim" }
      ],
      "gradients": [
        {
          "slug": "green-fade",
          "gradient": "linear-gradient(135deg, #2d6315 0%, #5cb800 100%)",
          "name": "Green Fade"
        },
        {
          "slug": "dark-fade",
          "gradient": "linear-gradient(135deg, #1a1d22 0%, #2d6315 100%)",
          "name": "Dark Fade"
        }
      ],
      "duotone": [
        {
          "slug": "green-dark",
          "colors": ["#2d6315", "#5cb800"],
          "name": "Green Duotone"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "'Barlow', sans-serif",
          "slug": "barlow",
          "name": "Barlow",
          "fontFace": [
            {
              "fontFamily": "Barlow",
              "fontWeight": "300 600",
              "fontStyle": "normal",
              "src": ["https://fonts.gstatic.com/s/barlow/v12/7cHpv4kjgoGqM7E3b8s8yn4.woff2"]
            }
          ]
        },
        {
          "fontFamily": "'Barlow Condensed', sans-serif",
          "slug": "barlow-condensed",
          "name": "Barlow Condensed",
          "fontFace": [
            {
              "fontFamily": "Barlow Condensed",
              "fontWeight": "400 900",
              "fontStyle": "normal",
              "src": ["https://fonts.gstatic.com/s/barlowcondensed/v12/HTxwL3I-JCGChYJ8VI-L6OO_au7B6xTT3g.woff2"]
            }
          ]
        },
        {
          "fontFamily": "system-ui, -apple-system, sans-serif",
          "slug": "system",
          "name": "System"
        }
      ],
      "fontSizes": [
        { "slug": "xs",    "size": "0.72rem",  "name": "Extra Small" },
        { "slug": "small", "size": "0.85rem",  "name": "Small" },
        { "slug": "medium","size": "1rem",     "name": "Medium" },
        { "slug": "large", "size": "1.25rem",  "name": "Large" },
        { "slug": "xl",    "size": "1.8rem",   "name": "Extra Large" },
        { "slug": "2xl",   "size": "2.5rem",   "name": "2X Large" },
        { "slug": "3xl",   "size": "3.5rem",   "name": "3X Large" },
        { "slug": "4xl",   "size": "5rem",     "name": "4X Large" }
      ],
      "fluid": true
    },
    "spacing": {
      "spacingScale": {
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem",
        "operator": "*",
        "increment": 1.5,
        "type": "fluid"
      },
      "spacingSizes": [
        { "slug": "10", "size": "0.25rem", "name": "2XS" },
        { "slug": "20", "size": "0.5rem",  "name": "XS" },
        { "slug": "30", "size": "0.75rem", "name": "S" },
        { "slug": "40", "size": "1rem",    "name": "M" },
        { "slug": "50", "size": "1.5rem",  "name": "L" },
        { "slug": "60", "size": "2.5rem",  "name": "XL" },
        { "slug": "70", "size": "4rem",    "name": "2XL" },
        { "slug": "80", "size": "6rem",    "name": "3XL" }
      ],
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "presets": [
        { "slug": "sm",  "shadow": "0 1px 4px rgba(0,0,0,0.05)",        "name": "Small" },
        { "slug": "md",  "shadow": "0 4px 18px rgba(92,184,0,0.13)",     "name": "Medium Green" },
        { "slug": "lg",  "shadow": "0 8px 32px rgba(0,0,0,0.12)",        "name": "Large" },
        { "slug": "deep","shadow": "0 4px 22px rgba(31,61,15,0.35)",      "name": "Deep Green" }
      ]
    },
    "blocks": {
      "core/button": {
        "color": {
          "background": true,
          "text": true
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--bg)",
      "text": "var(--wp--preset--color--text)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--barlow)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--50)"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--barlow-condensed)",
          "fontWeight": "900",
          "fontSize": "clamp(2.4rem, 7vw, 5rem)",
          "lineHeight": "0.93",
          "letterSpacing": "-0.01em",
          "textTransform": "uppercase"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--barlow-condensed)",
          "fontWeight": "800",
          "fontSize": "clamp(1.8rem, 4.5vw, 3rem)",
          "lineHeight": "1",
          "textTransform": "uppercase",
          "letterSpacing": "0.01em"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--barlow-condensed)",
          "fontWeight": "700",
          "fontSize": "var(--wp--preset--font-size--large)",
          "lineHeight": "1.15",
          "textTransform": "uppercase"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--barlow-condensed)",
          "fontWeight": "700",
          "fontSize": "var(--wp--preset--font-size--medium)",
          "textTransform": "uppercase"
        }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--green)" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--green-dark)" }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--green)",
          "text": "#ffffff"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--barlow-condensed)",
          "fontWeight": "700",
          "fontSize": "var(--wp--preset--font-size--small)",
          "letterSpacing": "0.1em",
          "textTransform": "uppercase"
        },
        "border": { "radius": "4px" },
        "spacing": {
          "padding": { "top": "0.7rem", "bottom": "0.7rem", "left": "1.4rem", "right": "1.4rem" }
        },
        ":hover": {
          "color": { "background": "var(--wp--preset--color--green-dark)" }
        }
      }
    },
    "blocks": {
      "core/separator": {
        "color": { "text": "var(--wp--preset--color--border)" },
        "border": { "color": "var(--wp--preset--color--border)" }
      },
      "core/quote": {
        "border": {
          "left": { "color": "var(--wp--preset--color--green)", "width": "3px", "style": "solid" }
        },
        "spacing": {
          "padding": { "left": "var(--wp--preset--spacing--50)" }
        }
      },
      "core/pullquote": {
        "border": {
          "top": { "color": "var(--wp--preset--color--green)", "width": "2px", "style": "solid" },
          "bottom": { "color": "var(--wp--preset--color--green)", "width": "2px", "style": "solid" }
        }
      },
      "core/code": {
        "color": { "background": "var(--wp--preset--color--surface)" },
        "border": { "radius": "4px" },
        "typography": { "fontSize": "var(--wp--preset--font-size--small)" }
      },
      "core/table": {
        "border": { "color": "var(--wp--preset--color--border)", "style": "solid", "width": "1px" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" },
    { "name": "sidebar", "title": "Sidebar", "area": "uncategorized" }
  ],
  "customTemplates": [
    { "name": "front-page",    "title": "Homepage",       "postTypes": ["page"] },
    { "name": "blank",         "title": "Blank",          "postTypes": ["page", "post"] },
    { "name": "no-sidebar",    "title": "No Sidebar",     "postTypes": ["page", "post"] },
    { "name": "full-width",    "title": "Full Width",     "postTypes": ["page"] },
    { "name": "landing-page",  "title": "Landing Page",   "postTypes": ["page"] }
  ],
  "patterns": [
    "gaptec/hero",
    "gaptec/stats-bar",
    "gaptec/cta-banner",
    "gaptec/feature-grid",
    "gaptec/testimonial"
  ]
}
