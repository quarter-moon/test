<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" data-scheme="{{ settings.color_scheme }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <title>
    {%- if page_title == blank -%}
      {{ shop.name }}
    {%- else -%}
      {{ page_title }} — {{ shop.name }}
    {%- endif -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">

  {{ 'pave-base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>

<body>
  {%- if settings.show_announcement -%}
    {%- section 'announcement-bar' -%}
  {%- endif -%}

  {%- render 'header' -%}

  <main id="main-content" role="main">
    {{ content_for_layout }}
  </main>

  {%- render 'footer' -%}
  {%- render 'cart-drawer' -%}
  {%- render 'search-overlay' -%}
  {%- render 'mobile-nav' -%}

  <div class="pave-toast is-hidden" id="pave-toast" role="status" aria-live="polite">
    <span style="color:var(--pave-gold-light);display:grid;place-items:center;width:30px;height:30px;border-radius:2px;border:1px solid rgba(212,180,131,.3);">
      {%- render 'icon', name: 'check' -%}
    </span>
    <div>
      <div style="font-size:13px;font-weight:500;">Added to your bag</div>
      <div id="pave-toast-name" style="font-size:11.5px;color:var(--pave-warm-gray-lt);"></div>
    </div>
    <button onclick="document.getElementById('pave-cart-overlay').classList.add('is-open')" style="background:none;border:1px solid rgba(212,180,131,.3);color:var(--pave-gold-light);border-radius:2px;padding:7px 12px;font-size:10px;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;">
      View Bag
    </button>
  </div>

  <script src="{{ 'pave-theme.js' | asset_url }}" defer></script>
</body>
</html>
