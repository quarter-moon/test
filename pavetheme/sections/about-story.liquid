<div class="pave-container" style="padding-block:var(--sp-24);">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-16);align-items:center;" class="pave-about-story">
    <div class="reveal">
      {%- if section.settings.title != blank -%}
        <h2 class="pave-display" style="font-size:clamp(28px,3vw,44px);color:var(--heading);font-weight:300;margin:0 0 var(--sp-6);">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p style="color:var(--ink-soft);line-height:1.8;max-width:520px;">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.text_2 != blank -%}
        <p style="color:var(--ink-soft);line-height:1.8;max-width:520px;margin-top:var(--sp-4);">{{ section.settings.text_2 }}</p>
      {%- endif -%}
      {%- if section.settings.quote != blank -%}
        <blockquote style="border-left:2px solid var(--accent);padding-left:var(--sp-6);margin:var(--sp-8) 0 0;font-style:italic;color:var(--ink);font-size:18px;line-height:1.6;">
          {{ section.settings.quote }}
          {%- if section.settings.quote_attribution != blank -%}
            <cite style="display:block;font-style:normal;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);margin-top:var(--sp-3);">— {{ section.settings.quote_attribution }}</cite>
          {%- endif -%}
        </blockquote>
      {%- endif -%}
    </div>
    <div class="reveal" style="background:var(--surface);border-radius:var(--pave-radius-card);aspect-ratio:4/5;overflow:hidden;display:flex;align-items:center;justify-content:center;">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.image.alt | escape }}" style="width:100%;height:100%;object-fit:cover;">
      {%- else -%}
        {%- render 'placeholder-gem', motif: 'pendant', size: 160 -%}
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  @media (max-width:767px) {
    .pave-about-story { grid-template-columns: 1fr !important; }
  }
</style>

{% schema %}
{
  "name": "About – Story",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Our Story" },
    { "type": "textarea", "id": "text", "label": "Story text" },
    { "type": "textarea", "id": "text_2", "label": "Second paragraph" },
    { "type": "textarea", "id": "quote", "label": "Pull quote" },
    { "type": "text", "id": "quote_attribution", "label": "Quote attribution" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ]
}
{% endschema %}
