<div class="pave-container" style="padding-block:var(--sp-12);">
  <div style="margin-bottom:40px;">
    <p class="pave-eyebrow" style="font-size:9.5px;margin-bottom:12px;">Our Collections</p>
    <h1 class="pave-display" style="font-size:clamp(34px,5vw,56px);font-weight:300;color:var(--heading);margin:0;">Shop by Collection</h1>
  </div>

  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:24px;">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        <a href="{{ collection.url }}" style="text-decoration:none;display:block;group:collection;">
          <div style="aspect-ratio:4/3;background:var(--surface);border-radius:4px;overflow:hidden;margin-bottom:16px;position:relative;">
            {%- if collection.image -%}
              <img
                src="{{ collection.image | image_url: width: 600 }}"
                alt="{{ collection.image.alt | escape }}"
                width="600"
                height="450"
                loading="lazy"
                style="width:100%;height:100%;object-fit:cover;transition:transform .4s ease;">
            {%- else -%}
              <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;">
                {%- render 'placeholder-gem', motif: collection.handle -%}
              </div>
            {%- endif -%}
            <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.35) 0%,transparent 50%);"></div>
            <div style="position:absolute;bottom:16px;left:16px;right:16px;">
              <span style="color:#fff;font-family:var(--ff-display);font-size:20px;font-weight:300;">{{ collection.title }}</span>
            </div>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <span style="color:var(--ink-soft);font-size:12px;letter-spacing:.04em;">{{ collection.products_count }} pieces</span>
            <span style="color:var(--accent-2);font-size:11px;letter-spacing:.08em;text-transform:uppercase;">Shop →</span>
          </div>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{ "name": "Collections List" }
{% endschema %}
