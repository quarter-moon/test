<div class="pave-container" style="padding-block:var(--sp-12);min-height:60vh;">
  <div style="margin-bottom:40px;">
    <p class="pave-eyebrow" style="font-size:9.5px;margin-bottom:12px;">Your Collection</p>
    <h1 class="pave-display" style="font-size:clamp(34px,5vw,56px);font-weight:300;color:var(--heading);margin:0 0 8px;">Wishlist</h1>
    <p id="pave-wish-count" style="color:var(--ink-soft);font-size:14px;">Loading…</p>
  </div>

  <div id="pave-wish-empty" style="display:none;text-align:center;padding:60px 0;">
    <p class="pave-display" style="font-size:22px;color:var(--heading);margin:0 0 12px;">Your wishlist is empty</p>
    <p style="color:var(--ink-soft);font-size:14px;margin-bottom:28px;">Save pieces you love and find them here.</p>
    <a href="/collections/all" class="pave-btn pave-btn--primary">Browse Collection</a>
  </div>

  <div id="pave-wish-grid" class="pave-prod-grid"></div>
</div>

<script>
(function () {
  const ids = JSON.parse(localStorage.getItem('pave-wishlist') || '[]');
  const countEl = document.getElementById('pave-wish-count');
  const emptyEl = document.getElementById('pave-wish-empty');
  const gridEl  = document.getElementById('pave-wish-grid');

  if (!ids.length) {
    countEl.style.display = 'none';
    emptyEl.style.display = 'block';
    return;
  }

  countEl.textContent = ids.length + ' ' + (ids.length === 1 ? 'piece' : 'pieces') + ' saved';

  // Fetch each product by ID via storefront
  let loaded = 0;
  ids.forEach(function (id) {
    fetch('/products.json?limit=250')
      .then(r => r.json())
      .then(data => {
        const product = data.products.find(p => p.id == id);
        if (!product) return;
        const card = document.createElement('article');
        card.className = 'pave-card reveal';
        const img = product.images[0]
          ? '<img src="' + product.images[0].src + '" alt="' + product.title + '" loading="lazy" style="width:100%;height:100%;object-fit:cover;">'
          : '<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--accent-2);font-size:48px;">◇</div>';
        const price = (product.variants[0].price / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' });
        card.innerHTML = `
          <div class="pave-card__image">
            <div class="pave-card__img-wrap">
              <a href="/products/${product.handle}">${img}</a>
            </div>
            <button class="pave-card__wish is-active" aria-label="Remove from wishlist"
              data-wishlist-btn="${product.id}"
              onclick="paveToggleWishlist(this,'${product.id}');this.closest('.pave-card').remove();updateCount();">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
            </button>
          </div>
          <div class="pave-card__body">
            <div class="pave-eyebrow pave-card__category" style="font-size:9.5px;">${product.product_type}</div>
            <h3 class="pave-display pave-card__name"><a href="/products/${product.handle}">${product.title}</a></h3>
            <div class="pave-card__foot">
              <span style="font-size:14px;color:var(--ink);">${price}</span>
              <button class="pave-card__add" aria-label="Add to bag"
                onclick="paveAddToCart(${product.variants[0].id},1)">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
            </div>
          </div>`;
        gridEl.appendChild(card);
        loaded++;
      });
  });

  window.updateCount = function () {
    const remaining = JSON.parse(localStorage.getItem('pave-wishlist') || '[]');
    countEl.textContent = remaining.length + ' ' + (remaining.length === 1 ? 'piece' : 'pieces') + ' saved';
    if (!remaining.length) { countEl.style.display = 'none'; emptyEl.style.display = 'block'; }
  };
})();
</script>

{% schema %}
{ "name": "Wishlist Page" }
{% endschema %}
