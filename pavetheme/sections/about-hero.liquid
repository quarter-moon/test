<div class="pave-about-hero reveal" style="background:var(--bg-dark,#1a1814);padding:var(--sp-32) 0;text-align:center;">
  <div class="pave-container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="pave-eyebrow" style="color:var(--accent);margin-bottom:var(--sp-4);">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="pave-display" style="font-size:clamp(36px,5vw,68px);color:#f4ede4;font-weight:300;max-width:800px;margin:0 auto var(--sp-6);">{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p style="font-size:18px;color:rgba(244,237,228,.6);max-width:560px;margin:0 auto;">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div style="display:flex;gap:var(--sp-12);justify-content:center;margin-top:var(--sp-16);flex-wrap:wrap;">
      <div style="text-align:center;">
        <div class="pave-display" style="font-size:48px;color:var(--accent);font-weight:300;">62+</div>
        <div style="font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:rgba(244,237,228,.5);margin-top:4px;">Years of craft</div>
      </div>
      <div style="text-align:center;">
        <div class="pave-display" style="font-size:48px;color:var(--accent);font-weight:300;">14k</div>
        <div style="font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:rgba(244,237,228,.5);margin-top:4px;">Pieces made</div>
      </div>
      <div style="text-align:center;">
        <div class="pave-display" style="font-size:48px;color:var(--accent);font-weight:300;">3</div>
        <div style="font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:rgba(244,237,228,.5);margin-top:4px;">Continents</div>
      </div>
      <div style="text-align:center;">
        <div class="pave-display" style="font-size:48px;color:var(--accent);font-weight:300;">∞</div>
        <div style="font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:rgba(244,237,228,.5);margin-top:4px;">Guarantee</div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About – Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "The House of Pavé" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Jewels made to outlast the moment." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Three generations of artisans. One obsession with light." }
  ]
}
{% endschema %}
