{% layout 'theme' %}

<div class="pave-container" style="padding-block:var(--sp-12);">
  <h1 class="pave-display" style="font-weight:300;font-size:clamp(34px,5vw,52px);color:var(--heading);margin:0 0 32px;">Your Bag</h1>

  {%- if cart.item_count == 0 -%}
    <div style="text-align:center;padding:60px 0;">
      <p class="pave-display" style="font-size:28px;color:var(--heading);">Your bag is empty</p>
      <p style="color:var(--ink-soft);">Beautiful things await.</p>
      <a href="{{ routes.collections_url }}" class="pave-btn pave-btn--primary" style="margin-top:16px;">Browse Jewelry</a>
    </div>
  {%- else -%}
    <div class="pave-checkout">
      <div>
        {%- for item in cart.items -%}
          <div style="display:flex;gap:20px;padding:24px 0;border-bottom:1px solid var(--divider);">
            <a href="{{ item.url }}" style="width:100px;flex-shrink:0;border-radius:var(--pave-radius-card);overflow:hidden;border:1px solid var(--divider);">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" width="100" height="100" style="width:100%;height:100%;object-fit:cover;">
              {%- endif -%}
            </a>
            <div style="flex:1;">
              <div class="pave-display" style="font-size:18px;color:var(--ink);">{{ item.product.title }}</div>
              {%- if item.variant.title != 'Default Title' -%}
                <div style="font-size:12px;color:var(--ink-soft);margin-top:4px;">{{ item.variant.title }}</div>
              {%- endif -%}
              {%- for p in item.properties -%}
                {%- if p.last != blank -%}
                  <div style="font-size:12px;color:var(--ink-soft);">{{ p.first }}: {{ p.last }}</div>
                {%- endif -%}
              {%- endfor -%}
              <div style="display:flex;align-items:center;gap:20px;margin-top:14px;">
                <form action="{{ routes.cart_url }}" method="post">
                  <div class="pave-qty">
                    <button name="updates[{{ item.key }}]" value="{{ item.quantity | minus: 1 }}" class="pave-qty__btn" style="font-size:13px;">−</button>
                    <span class="pave-qty__val">{{ item.quantity }}</span>
                    <button name="updates[{{ item.key }}]" value="{{ item.quantity | plus: 1 }}" class="pave-qty__btn" style="font-size:13px;">+</button>
                  </div>
                </form>
                <a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0" style="color:var(--ink-soft);font-size:11.5px;text-decoration:underline;">Remove</a>
              </div>
            </div>
            <div>
              {%- render 'price', variant: item.variant -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="pave-checkout-summary">
        <div style="padding:24px 26px;border-bottom:1px solid var(--divider);">
          <div style="display:flex;justify-content:space-between;font-size:13.5px;color:var(--ink-soft);margin-bottom:10px;">
            <span>Subtotal</span>
            <span style="color:var(--ink);font-weight:500;">{{ cart.total_price | money }}</span>
          </div>
          <div style="display:flex;justify-content:space-between;font-size:13.5px;color:var(--ink-soft);margin-bottom:10px;">
            <span>Shipping</span>
            <span style="color:var(--accent-2);">Complimentary</span>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:baseline;border-top:1px solid var(--divider);padding-top:14px;margin-top:4px;">
            <span class="pave-display" style="font-size:20px;color:var(--heading);">Total</span>
            <span class="pave-display" style="font-size:28px;color:var(--ink);">{{ cart.total_price | money }}</span>
          </div>
        </div>
        <div style="padding:20px 26px;">
          <a href="/checkout" class="pave-btn pave-btn--gold pave-btn--full" style="height:50px;font-size:12px;">Proceed to Checkout</a>
          <a href="{{ routes.collections_url }}" style="display:block;text-align:center;color:var(--ink-soft);font-size:11px;letter-spacing:.1em;text-transform:uppercase;margin-top:14px;">Continue Shopping</a>
        </div>
        <div style="padding:16px 26px;background:var(--bg-alt);display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
          <span style="display:inline-flex;gap:6px;align-items:center;font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft);">{%- render 'icon', name: 'shield', size: 13 -%} Certified</span>
          <span style="display:inline-flex;gap:6px;align-items:center;font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft);">{%- render 'icon', name: 'truck', size: 13 -%} Insured</span>
          <span style="display:inline-flex;gap:6px;align-items:center;font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft);">{%- render 'icon', name: 'gift', size: 13 -%} Gift wrap</span>
        </div>
      </div>
    </div>
  {%- endif -%}
</div>
