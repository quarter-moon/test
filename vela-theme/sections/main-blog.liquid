{%- paginate blog.articles by section.settings.articles_per_page -%}

<!-- Blog Masthead — stone bg, matches JSX VBlog -->
<div class="blog-header">
  <div class="blog-header-eyebrow fade-up">{{ section.settings.eyebrow | default: 'Vol. 01 · Resort 26' }}</div>
  <h1 class="blog-header-title fade-up">
    The <em>{{ blog.title | default: 'Journal' }}</em>
  </h1>
  <div style="width:50px; height:1px; background:var(--clay); margin:14px auto; opacity:0.7;"></div>
  {%- if section.settings.subtitle != blank -%}
    <p class="blog-header-sub fade-up">{{ section.settings.subtitle }}</p>
  {%- endif -%}
</div>

<!-- Featured Article (first article, full-bleed) -->
{%- assign featured = blog.articles.first -%}
{%- if featured and section.settings.show_featured -%}
  <section style="background: #F0EEE9; padding: 0 0 36px;">
    <a href="{{ featured.url }}" style="display:block;">
      {%- if featured.image -%}
        <div style="position:relative;">
          <img
            src="{{ featured.image | image_url: width: 780 }}"
            srcset="{{ featured.image | image_url: width: 390 }} 390w, {{ featured.image | image_url: width: 780 }} 780w"
            sizes="100vw"
            alt="{{ featured.image.alt | escape | default: featured.title }}"
            style="width:100%; aspect-ratio:16/10; object-fit:cover;"
            loading="eager"
          >
          <div style="position:absolute; top:16px; left:16px; background:var(--stone); padding:5px 10px; font:9px/1 'DM Sans',sans-serif; letter-spacing:0.24em; text-transform:uppercase; color:var(--ink);">
            Featured · {{ featured.tags.first | default: 'Atelier' }}
          </div>
        </div>
      {%- endif -%}
      <div style="padding: 24px 24px 0;">
        <div style="font-size:9px; letter-spacing:0.32em; text-transform:uppercase; color:var(--clay); margin-bottom:10px;">
          {{ featured.tags.first | default: 'Essay' }} · {{ section.settings.read_time | default: '5 min read' }}
        </div>
        <h2 style="font-family:var(--font-heading); font-size:clamp(24px,7vw,32px); font-weight:300; color:var(--ink); margin:0 0 12px; letter-spacing:0.005em; line-height:1.15;">
          {{ featured.title }}
        </h2>
        {%- if featured.excerpt != blank -%}
          <p style="font-size:14px; line-height:1.7; color:var(--ash); margin:0 0 16px;">
            {{ featured.excerpt | strip_html | truncate: 160 }}
          </p>
        {%- endif -%}
        <div style="display:flex; align-items:center; gap:10px; font-size:10px; letter-spacing:0.16em; text-transform:uppercase; color:var(--ash);">
          <div style="width:24px; height:24px; border-radius:50%; background:var(--clay);"></div>
          {{ featured.author }}
          <span style="opacity:0.4;">·</span>
          {{ featured.published_at | date: '%B %-d, %Y' }}
        </div>
      </div>
    </a>
  </section>
{%- endif -%}

<!-- Quiet Index — accordion-style list matching JSX VBlog -->
<section class="blog-quiet-index">
  {%- assign start = 0 -%}
  {%- if section.settings.show_featured and blog.articles.size > 0 -%}
    {%- assign start = 1 -%}
  {%- endif -%}
  {%- for article in blog.articles offset: start -%}
    <article class="blog-index-item" data-blog-index="{{ forloop.index }}">
      <div class="blog-index-row">
        <div class="blog-index-num">{{ forloop.index | plus: start | prepend: '0' | slice: -2, 2 }}</div>
        <div class="blog-index-body">
          <div class="blog-index-cat">
            {{ article.tags.first | default: 'Journal' }} · {{ section.settings.read_time | default: '5 min' }}
          </div>
          <h2 class="blog-index-title">{{ article.title }}</h2>
          <div class="blog-index-author">
            {{ article.author }} · {{ article.published_at | date: '%b %-d' }}
          </div>
        </div>
        <button class="blog-index-toggle" aria-label="Expand article preview" aria-expanded="false">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 5v14M5 12h14"/>
          </svg>
        </button>
      </div>
      <div class="blog-index-panel" aria-hidden="true">
        {%- if article.image -%}
          <div class="blog-index-panel-image">
            <img
              src="{{ article.image | image_url: width: 560 }}"
              alt="{{ article.image.alt | escape | default: article.title }}"
              loading="lazy"
            >
          </div>
        {%- endif -%}
        {%- if article.excerpt != blank -%}
          <p class="blog-index-excerpt">"{{ article.excerpt | strip_html | truncate: 200 }}"</p>
        {%- endif -%}
        <a href="{{ article.url }}" class="blog-index-read-more">Continue reading →</a>
      </div>
    </article>
  {%- else -%}
    <p style="padding:80px 24px; text-align:center; font-family:var(--font-heading); font-style:italic; font-size:20px; color:var(--ash);">
      No articles yet — check back soon.
    </p>
  {%- endfor -%}
</section>

<!-- Archive / Load more -->
{%- if paginate.pages > 1 -%}
  <section style="padding:32px 24px 56px; text-align:center; background:var(--stone);">
    <div style="font-size:11px; color:var(--ash); letter-spacing:0.06em; margin-bottom:14px;">
      Showing {{ blog.articles | size | minus: start }} of {{ blog.articles_count }}
    </div>
    <nav class="pagination" aria-label="Blog pagination" style="justify-content:center; margin-bottom:24px;">
      {%- if paginate.previous -%}
        <a href="{{ paginate.previous.url }}" class="pagination-link">←</a>
      {%- endif -%}
      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}
          <a href="{{ part.url }}" class="pagination-link">{{ part.title }}</a>
        {%- else -%}
          <span class="pagination-link active">{{ part.title }}</span>
        {%- endif -%}
      {%- endfor -%}
      {%- if paginate.next -%}
        <a href="{{ paginate.next.url }}" class="pagination-link">→</a>
      {%- endif -%}
    </nav>
  </section>
{%- endif -%}

{%- endpaginate -%}

<script>
  document.querySelectorAll('.blog-index-item').forEach(function(item) {
    var toggle = item.querySelector('.blog-index-toggle');
    if (!toggle) return;
    toggle.addEventListener('click', function(e) {
      e.stopPropagation();
      var isOpen = item.classList.contains('is-open');
      document.querySelectorAll('.blog-index-item.is-open').forEach(function(i) {
        i.classList.remove('is-open');
        i.querySelector('.blog-index-toggle').setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('is-open');
        toggle.setAttribute('aria-expanded', 'true');
      }
    });
    item.querySelector('.blog-index-row').addEventListener('click', function() {
      toggle.click();
    });
  });
</script>

{% schema %}
{
  "name": "Main Blog",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Volume / eyebrow",
      "default": "Vol. 01 · Resort 26"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Reading material from the studio. Notes on craft, slowness, and getting dressed."
    },
    {
      "type": "checkbox",
      "id": "show_featured",
      "label": "Show first article as featured hero",
      "default": true
    },
    {
      "type": "text",
      "id": "read_time",
      "label": "Default read time label",
      "default": "5 min"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "min": 6,
      "max": 24,
      "step": 2,
      "label": "Articles per page",
      "default": 10
    }
  ]
}
{% endschema %}
