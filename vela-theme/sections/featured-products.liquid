<section class="section" style="background: {{ section.settings.background | default: 'var(--stone)' }};">
  <div class="container">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="label-caps fade-up">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <div class="section-rule fade-up"></div>
        <h2 class="fade-up" style="font-family: var(--font-heading); font-weight: 300; font-size: clamp(24px, 5vw, 48px);">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="fade-up" style="font-family: var(--font-heading); font-style: italic; font-size: 17px; color: var(--ash); margin-top: 8px;">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- assign source_collection = collections[section.settings.collection] -%}

    <div class="collection-grid">
      {%- if source_collection != blank and source_collection.products.size > 0 -%}
        {%- for product in source_collection.products limit: section.settings.product_limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'product' -%}
            {%- assign prod = all_products[block.settings.product] -%}
            {%- if prod != blank -%}
              {% render 'product-card', product: prod %}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="text-center">
        <a href="{{ section.settings.cta_url | default: routes.collections_url }}" class="section-link fade-up">
          {{ section.settings.cta_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Just Arrived"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Auto-populate from collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 2,
      "max": 12,
      "step": 2,
      "label": "Products to show (from collection)",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Link label",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link URL"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Section background",
      "options": [
        { "value": "var(--stone)", "label": "Stone (light)" },
        { "value": "var(--pebble)", "label": "Pebble (warm grey)" },
        { "value": "var(--ink)", "label": "Ink (dark)" },
        { "value": "#FFFFFF", "label": "White" }
      ],
      "default": "var(--stone)"
    }
  ],
  "presets": [
    {
      "name": "Featured Products",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
