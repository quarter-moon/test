<div class="announcement-bar" role="status">
  {%- if section.settings.announcement_text != blank -%}
    <span>{{ section.settings.announcement_text }}</span>
  {%- else -%}
    <span>Free shipping on orders over $150 &nbsp;·&nbsp; <a href="{{ section.settings.announcement_link | default: routes.collections_url }}">Shop Now</a></span>
  {%- endif -%}
</div>

<header class="site-header{% if section.settings.transparent %} header--transparent{% endif %}" role="banner">
  <div class="header-inner">
    <!-- Mobile menu toggle -->
    <button
      class="menu-toggle"
      aria-label="{{ 'accessibility.open_menu' | t }}"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <!-- Logo -->
    <a href="{{ routes.root_url }}" class="header-logo" aria-label="{{ shop.name }} home">
      {%- if section.settings.logo_image -%}
        <img
          src="{{ section.settings.logo_image | image_url: width: 200 }}"
          alt="{{ shop.name }}"
          width="{{ section.settings.logo_width }}"
          height="auto"
          loading="eager"
        >
      {%- else -%}
        VELA
      {%- endif -%}
    </a>

    <!-- Desktop Navigation -->
    <nav class="header-nav" aria-label="Main navigation">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>
          {{ link.title }}
        </a>
      {%- endfor -%}
    </nav>

    <!-- Actions -->
    <div class="header-actions">
      <button class="header-icon" data-search-open aria-label="{{ 'general.search.search' | t }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
      </button>

      <a href="{{ routes.account_url }}" class="header-icon" aria-label="Account">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
        </svg>
      </a>

      <button class="header-icon" data-cart-open aria-label="{{ 'accessibility.open_cart' | t }}" style="position:relative">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="cart-count">{{ cart.item_count }}</span>
        {%- endif -%}
      </button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Free shipping on orders over $150 — Shop New Arrivals"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement link"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image (optional)"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 280,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 140
    },
    {
      "type": "checkbox",
      "id": "transparent",
      "label": "Transparent header on homepage",
      "default": false
    }
  ]
}
{% endschema %}
