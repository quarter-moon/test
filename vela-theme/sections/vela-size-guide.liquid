  <div class="sg-container sg-tab-bar-inner">
    <nav class="sg-tabs" role="tablist" aria-label="Category">
      <button class="sg-tab is-active" data-tab="women" role="tab" aria-selected="true">Women</button>
      <button class="sg-tab" data-tab="men" role="tab" aria-selected="false">Men</button>
      <button class="sg-tab" data-tab="knitwear" role="tab" aria-selected="false">Knitwear</button>
      <button class="sg-tab" data-tab="shoes" role="tab" aria-selected="false">Shoes</button>
