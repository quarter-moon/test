<!-- ── How to Measure ─────────────────────────────── -->
<section class="sg-measure" id="sg-measure">
  <div class="sg-container">
    <div class="sg-measure-head">
      <div class="sg-eyebrow">How to Measure</div>
      <div>
        <h2 class="sg-section-heading">{{ section.settings.measure_heading | default: 'A tape, a friend, and <em>three minutes.</em>' }}</h2>
        <p class="sg-measure-intro">{{ section.settings.measure_intro | default: 'Measurements are taken over light clothing, with the tape held snug but not pulled tight. Stand naturally — knees soft, weight even.' }}</p>
      </div>
    </div>
    <div class="sg-measure-grid">
      <!-- SVG body figure -->
      <figure class="sg-figure-card" aria-hidden="true">
        <svg viewBox="0 0 320 480" fill="none" stroke="#1A1A1A" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <!-- Head -->
          <ellipse cx="160" cy="52" rx="26" ry="32" stroke="#1A1A1A"/>
          <!-- Neck -->
          <line x1="148" y1="82" x2="143" y2="100"/>
          <line x1="172" y1="82" x2="177" y2="100"/>
          <!-- Shoulders -->
          <path d="M143 100 Q100 108 86 124"/>
          <path d="M177 100 Q220 108 234 124"/>
          <!-- Arms -->
          <path d="M86 124 Q78 160 80 196 Q82 220 85 240"/>
          <path d="M234 124 Q242 160 240 196 Q238 220 235 240"/>
          <!-- Torso sides -->
          <path d="M86 124 Q82 148 84 168 Q86 188 90 200"/>
          <path d="M234 124 Q238 148 236 168 Q234 188 230 200"/>
          <!-- Waist -->
          <path d="M90 200 Q120 210 160 212 Q200 210 230 200"/>
          <!-- Hip flare -->
          <path d="M90 200 Q82 228 80 252"/>
          <path d="M230 200 Q238 228 240 252"/>
          <path d="M80 252 Q84 260 90 264"/>
          <path d="M240 252 Q236 260 230 264"/>
          <!-- Crotch -->
          <path d="M90 264 Q120 278 160 282 Q200 278 230 264"/>
          <!-- Legs -->
          <path d="M90 264 Q86 300 84 340 Q82 380 84 420"/>
          <path d="M230 264 Q234 300 236 340 Q238 380 236 420"/>
          <path d="M160 282 Q155 320 154 360 Q152 390 154 420"/>
          <path d="M160 282 Q165 320 166 360 Q168 390 166 420"/>
          <!-- Feet -->
          <path d="M84 420 Q80 430 78 436 Q90 440 100 436"/>
          <path d="M236 420 Q240 430 242 436 Q230 440 220 436"/>
          <path d="M154 420 Q150 432 148 438 Q160 442 172 438 Q170 432 166 420"/>

          <!-- Measurement A: Bust -->
          <line x1="52" y1="148" x2="268" y2="148" stroke="#B89372" stroke-dasharray="4 3" opacity="0.6"/>
          <circle cx="52" cy="148" r="3" fill="#B89372" stroke="none"/>
          <circle cx="268" cy="148" r="3" fill="#B89372" stroke="none"/>
          <text x="36" y="152" font-family="DM Sans, sans-serif" font-size="9" fill="#B89372" font-weight="500" text-anchor="middle">A</text>

          <!-- Measurement B: Waist -->
          <line x1="62" y1="202" x2="258" y2="202" stroke="#B89372" stroke-dasharray="4 3" opacity="0.6"/>
          <circle cx="62" cy="202" r="3" fill="#B89372" stroke="none"/>
          <circle cx="258" cy="202" r="3" fill="#B89372" stroke="none"/>
          <text x="46" y="206" font-family="DM Sans, sans-serif" font-size="9" fill="#B89372" font-weight="500" text-anchor="middle">B</text>

          <!-- Measurement C: Hip -->
          <line x1="52" y1="248" x2="268" y2="248" stroke="#B89372" stroke-dasharray="4 3" opacity="0.6"/>
          <circle cx="52" cy="248" r="3" fill="#B89372" stroke="none"/>
          <circle cx="268" cy="248" r="3" fill="#B89372" stroke="none"/>
          <text x="36" y="252" font-family="DM Sans, sans-serif" font-size="9" fill="#B89372" font-weight="500" text-anchor="middle">C</text>

          <!-- Measurement D: Inseam -->
          <line x1="268" y1="282" x2="268" y2="420" stroke="#B89372" stroke-dasharray="4 3" opacity="0.6"/>
          <circle cx="268" cy="282" r="3" fill="#B89372" stroke="none"/>
          <circle cx="268" cy="420" r="3" fill="#B89372" stroke="none"/>
          <text x="284" y="354" font-family="DM Sans, sans-serif" font-size="9" fill="#B89372" font-weight="500" text-anchor="middle">D</text>
        </svg>
      </figure>

      <!-- Steps -->
      <div class="sg-steps">
        <div class="sg-step">
          <div class="sg-step-num">A</div>
          <div>
            <h3 class="sg-step-title">Across the <em>bust</em></h3>
            <p class="sg-step-body">{{ section.settings.step_a | default: 'Measure around the fullest part of your chest, keeping the tape parallel to the floor. Arms relaxed at your sides.' }}</p>
          </div>
        </div>
        <div class="sg-step">
          <div class="sg-step-num">B</div>
          <div>
            <h3 class="sg-step-title">The natural <em>waist</em></h3>
            <p class="sg-step-body">{{ section.settings.step_b | default: 'Find the narrowest point of your torso — usually an inch above the navel. Measure there, not at the hip bone.' }}</p>
          </div>
        </div>
        <div class="sg-step">
          <div class="sg-step-num">C</div>
          <div>
            <h3 class="sg-step-title">Around the <em>hip</em></h3>
            <p class="sg-step-body">{{ section.settings.step_c | default: 'Stand with feet together. Measure around the widest part of your hips and seat, about 8 inches below the waist.' }}</p>
          </div>
        </div>
        <div class="sg-step">
          <div class="sg-step-num">D</div>
          <div>
            <h3 class="sg-step-title">The <em>inseam</em></h3>
            <p class="sg-step-body">{{ section.settings.step_d | default: 'From the crotch seam to the ankle bone, along the inner leg. Measure a pair of trousers that fit well, or ask a friend.' }}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

