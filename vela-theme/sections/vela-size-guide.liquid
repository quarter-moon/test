        <h1 class="sg-intro-heading">{{ section.settings.intro_heading | default: 'The right cut, <em>kept</em> for many years.' }}</h1>
        <p class="sg-intro-lede">{{ section.settings.intro_lede | default: 'Our patterns are drafted to the body, not the warehouse. Use the measurements below as a starting point — and if you're between sizes, size down for closer, up for considered.' }}</p>
      </div>
      <nav class="sg-quick-links" aria-label="Jump to section">
        <a class="sg-quick-link" href="#sg-measure">
          <span>How to measure</span><span class="sg-quick-link-sub">Three minutes</span>
