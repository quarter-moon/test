<!-- ── Fit Philosophy ──────────────────────────────── -->
<section class="sg-fit" id="sg-fit">
  <div class="sg-fit-copy">
    <div class="sg-container">
      <div class="sg-eyebrow sg-eyebrow--light">Fit Philosophy</div>
      <h2 class="sg-section-heading sg-section-heading--light">{{ section.settings.fit_heading | default: 'We cut to the body, <em>not the rack.</em>' }}</h2>
      <dl class="sg-fit-pairs">
        <div class="sg-fit-pair">
          <dt>Tailoring</dt>
          <dd>{{ section.settings.fit_tailoring | default: 'Take your natural size. Linen jackets soften with wear and ease half a size within a season.' }}</dd>
        </div>
        <div class="sg-fit-pair">
          <dt>Linen</dt>
          <dd>{{ section.settings.fit_linen | default: 'Size down for closer, up for considered. The cloth relaxes; the cut does not.' }}</dd>
        </div>
        <div class="sg-fit-pair">
          <dt>Knitwear</dt>
          <dd>{{ section.settings.fit_knitwear | default: 'Two builds: Held (close) and Long (relaxed). Held runs true; Long is meant oversized.' }}</dd>
        </div>
        <div class="sg-fit-pair">
          <dt>Trousers</dt>
          <dd>{{ section.settings.fit_trousers | default: 'The waist is true; the rise is generous. We can take in the waist for free, in-studio.' }}</dd>
        </div>
      </dl>
    </div>
  </div>
  <div class="sg-fit-media">
    {%- if section.settings.fit_image -%}
      <img
        src="{{ section.settings.fit_image | image_url: width: 900 }}"
        alt="{{ section.settings.fit_image.alt | default: 'Fit' | escape }}"
        loading="lazy"
      >
    {%- else -%}
      <div class="sg-fit-media-placeholder"></div>
    {%- endif -%}
  </div>
</section>

<!-- ── FAQ ────────────────────────────────────────── -->
<section class="sg-faq" id="sg-faq">
  <div class="sg-container">
    <div class="sg-faq-head">
      <div>
        <div class="sg-eyebrow">Questions</div>
        <h2 class="sg-section-heading">{{ section.settings.faq_heading | default: 'Eight things you've <em>asked.</em>' }}</h2>
      </div>
      <div class="sg-faq-list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' -%}
            <details class="sg-faq-item" {{ block.shopify_attributes }}>
              <summary class="sg-faq-summary">
                <span class="sg-faq-num">0{{ forloop.index }}</span>
                <span class="sg-faq-q">{{ block.settings.question }}</span>
                <span class="sg-faq-icon" aria-hidden="true"></span>
              </summary>
              <div class="sg-faq-answer">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
        {%- if section.blocks == empty -%}
          <details class="sg-faq-item"><summary class="sg-faq-summary"><span class="sg-faq-num">01</span><span class="sg-faq-q">I'm between two sizes — which do I take?</span><span class="sg-faq-icon" aria-hidden="true"></span></summary><div class="sg-faq-answer"><p>For tailoring and trousers, size down — the cut is generous and tailors better. For knitwear, size up for the intended look. When in doubt, email us with your measurements and we will advise.</p></div></details>
          <details class="sg-faq-item"><summary class="sg-faq-summary"><span class="sg-faq-num">02</span><span class="sg-faq-q">Will the linen shrink after the first wash?</span><span class="sg-faq-icon" aria-hidden="true"></span></summary><div class="sg-faq-answer"><p>Linen relaxes slightly with washing — typically 3–5% on the first cold wash. We account for this in our patterns. Follow the care label: cool water, line dry.</p></div></details>
          <details class="sg-faq-item"><summary class="sg-faq-summary"><span class="sg-faq-num">03</span><span class="sg-faq-q">Do you offer alterations?</span><span class="sg-faq-icon" aria-hidden="true"></span></summary><div class="sg-faq-answer"><p>Yes. Waist adjustments on trousers are free in-studio. Hem shortening is charged at cost. Email studio@vela.com to arrange.</p></div></details>
          <details class="sg-faq-item"><summary class="sg-faq-summary"><span class="sg-faq-num">04</span><span class="sg-faq-q">Are returns possible if it doesn't fit?</span><span class="sg-faq-icon" aria-hidden="true"></span></summary><div class="sg-faq-answer"><p>Yes — within 30 days of delivery in original condition. We send a prepaid label. See our <a href="/pages/returns">Returns page</a> for full details.</p></div></details>
          <details class="sg-faq-item"><summary class="sg-faq-summary"><span class="sg-faq-num">05</span><span class="sg-faq-q">How does VELA sizing compare to other houses?</span><span class="sg-faq-icon" aria-hidden="true"></span></summary><div class="sg-faq-answer"><p>We size to the body, not the rack. Our measurements are generous relative to most contemporary labels — customers who wear a 10 elsewhere typically find a VELA 8 fits well. When in doubt, measure.</p></div></details>
          <details class="sg-faq-item"><summary class="sg-faq-summary"><span class="sg-faq-num">06</span><span class="sg-faq-q">Do you make sizes beyond 3XL?</span><span class="sg-faq-icon" aria-hidden="true"></span></summary><div class="sg-faq-answer"><p>Our standard range runs to 3XL (UK 16). Made-to-measure is available for sizes outside the range — email us to discuss.</p></div></details>
          <details class="sg-faq-item"><summary class="sg-faq-summary"><span class="sg-faq-num">07</span><span class="sg-faq-q">Can I be measured in-store?</span><span class="sg-faq-icon" aria-hidden="true"></span></summary><div class="sg-faq-answer"><p>Yes. We offer fitting appointments at our Copenhagen studio. We measure, photograph each fit, and keep a size card on file for future seasons. Book below.</p></div></details>
          <details class="sg-faq-item"><summary class="sg-faq-summary"><span class="sg-faq-num">08</span><span class="sg-faq-q">What if the size still isn't right?</span><span class="sg-faq-icon" aria-hidden="true"></span></summary><div class="sg-faq-answer"><p>We will sort it. Email studio@vela.com with photos and your measurements. We have yet to encounter a fit problem we could not resolve.</p></div></details>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<!-- ── Appointment CTA ─────────────────────────────── -->
<section class="sg-appointment" id="sg-appointment">
  <div class="sg-container">
    <div class="sg-appt-card">
      <div class="sg-appt-copy">
        <div class="sg-eyebrow">Try It On</div>
        <h2 class="sg-section-heading">{{ section.settings.appt_heading | default: 'Or, come to the <em>studio.</em>' }}</h2>
        <p class="sg-appt-body">{{ section.settings.appt_body | default: 'Forty minutes, by appointment. We measure, photograph each fit, and post you a size card — kept on file for next season.' }}</p>
        <div class="sg-appt-actions">
          <a href="{{ section.settings.appt_primary_url | default: '/pages/contact' }}" class="sg-appt-btn sg-appt-btn--solid">
            {{ section.settings.appt_primary_label | default: 'Book a Fitting →' }}
          </a>
          <a href="mailto:studio@vela.com" class="sg-appt-btn">
            {{ section.settings.appt_secondary_label | default: 'Write to the Studio' }}
          </a>
        </div>
      </div>
      <div class="sg-appt-meta">
        <div class="sg-appt-row">
          <span class="sg-appt-key">Address</span>
          <span class="sg-appt-val">{{ section.settings.appt_address | default: 'Vesterbrogade 14, Copenhagen' }}</span>
        </div>
        <div class="sg-appt-row">
          <span class="sg-appt-key">Hours</span>
          <span class="sg-appt-val">{{ section.settings.appt_hours | default: 'Wed–Sat · by appointment' }}</span>
        </div>
        <div class="sg-appt-row">
          <span class="sg-appt-key">Service</span>
          <span class="sg-appt-val">{{ section.settings.appt_service | default: 'Fittings · Mending · Made-to-measure' }}</span>
        </div>
        <div class="sg-appt-row">
          <span class="sg-appt-key">Fee</span>
          <span class="sg-appt-val">{{ section.settings.appt_fee | default: 'None.' }}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
(function() {
  // Unit toggle
  var unitBtns = document.querySelectorAll('.sg-unit-btn');
  unitBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var unit = btn.dataset.unit;
      unitBtns.forEach(function(b) {
        b.classList.toggle('is-active', b.dataset.unit === unit);
        b.setAttribute('aria-pressed', b.dataset.unit === unit ? 'true' : 'false');
      });
      document.querySelectorAll('[data-unit-body]').forEach(function(tbody) {
        tbody.hidden = tbody.dataset.unitBody !== unit;
      });
    });
  });

  // Category tabs
  var tabs = document.querySelectorAll('.sg-tab');
  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      var panel = tab.dataset.tab;
      tabs.forEach(function(t) {
        t.classList.toggle('is-active', t.dataset.tab === panel);
        t.setAttribute('aria-selected', t.dataset.tab === panel ? 'true' : 'false');
      });
      document.querySelectorAll('[data-panel]').forEach(function(el) {
        el.hidden = el.dataset.panel !== panel;
      });
    });
  });
})();
</script>

