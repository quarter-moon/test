<div class="marquee-bar" aria-hidden="true">
  <div class="marquee-track">
    {%- for i in (1..6) -%}
      {%- for block in section.blocks -%}
        <span>{{ block.settings.text }}</span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee Ticker",
  "blocks": [
    {
      "type": "item",
      "name": "Ticker item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on orders over $150"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee Ticker",
      "blocks": [
        { "type": "item", "settings": { "text": "Free shipping on orders over $150" } },
        { "type": "item", "settings": { "text": "New arrivals every Thursday" } },
        { "type": "item", "settings": { "text": "Easy 30-day returns" } },
        { "type": "item", "settings": { "text": "Sustainably crafted" } }
      ]
    }
  ]
}
{% endschema %}
