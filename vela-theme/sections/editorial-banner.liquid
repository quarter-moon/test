<div class="editorial-banner {% if section.settings.reversed %}editorial-banner--reversed{% endif %}">
  <div class="editorial-banner-image">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1000 }}"
        srcset="
          {{ section.settings.image | image_url: width: 600 }} 600w,
          {{ section.settings.image | image_url: width: 1000 }} 1000w,
          {{ section.settings.image | image_url: width: 1400 }} 1400w
        "
        sizes="(min-width: 768px) 50vw, 100vw"
        alt="{{ section.settings.image.alt | escape | default: section.settings.headline }}"
        loading="lazy"
      >
    {%- else -%}
      <div style="width:100%; height:100%; background: var(--pebble);"></div>
    {%- endif -%}
  </div>

  <div class="editorial-banner-content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="editorial-banner-eyebrow fade-up">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.headline != blank -%}
      <h2 class="editorial-banner-title fade-up">{{ section.settings.headline }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <p class="editorial-banner-body fade-up">{{ section.settings.body }}</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_url | default: routes.collections_url }}" class="btn btn-outline-light fade-up">
        {{ section.settings.cta_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Editorial Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Story"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline",
      "default": "Effortless Dressing for <em>Every Season</em>"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Thoughtfully sourced fabrics. Enduring silhouettes. Pieces that move with you from morning through evening."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Explore the Collection"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    },
    {
      "type": "checkbox",
      "id": "reversed",
      "label": "Reverse layout (image right)",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Editorial Banner"
    }
  ]
}
{% endschema %}
