{%- if section.settings.show_bar -%}
<div class="announcement-bar" role="banner">
  <span>
    {%- if section.settings.text != blank -%}
      {{ section.settings.text }}
      {%- if section.settings.link != blank -%}
        &nbsp;<a href="{{ section.settings.link }}">{{ section.settings.link_text }}</a>
      {%- endif -%}
    {%- else -%}
      Free shipping on orders over $150 &mdash; <a href="/collections/new-in">Shop New Arrivals</a>
    {%- endif -%}
  </span>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "limit": 1,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_bar",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "Free shipping on orders over $150"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link URL"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Shop Now"
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}
