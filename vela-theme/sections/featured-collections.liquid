<section class="section bg-stone">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-header">
        <p class="label-caps fade-up">{{ section.settings.eyebrow | default: 'Categories' }}</p>
        <div class="section-rule fade-up" aria-hidden="true"></div>
        <h2 class="fade-up" style="font-family: var(--font-heading); font-weight: 300;">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="category-cards">
      {%- for block in section.blocks -%}
        {%- if block.type == 'collection' -%}
          {%- assign coll = collections[block.settings.collection] -%}
          <a href="{{ coll.url | default: routes.collections_url }}" class="category-card fade-up" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                srcset="
                  {{ block.settings.image | image_url: width: 400 }} 400w,
                  {{ block.settings.image | image_url: width: 800 }} 800w,
                  {{ block.settings.image | image_url: width: 1200 }} 1200w
                "
                sizes="(min-width: 768px) 25vw, 50vw"
                alt="{{ block.settings.image.alt | escape | default: block.settings.title }}"
                loading="lazy"
              >
            {%- elsif coll.featured_image -%}
              <img
                src="{{ coll.featured_image | image_url: width: 800 }}"
                alt="{{ coll.featured_image.alt | escape | default: coll.title }}"
                loading="lazy"
              >
            {%- endif -%}
            <div class="category-card-label">
              <div class="category-card-name">{{ block.settings.title | default: coll.title }}</div>
              {%- if coll.products_count -%}
                <div class="category-card-count">{{ coll.products_count }} Pieces</div>
              {%- endif -%}
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collections",
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Override image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Override title"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Edit"
    }
  ],
  "presets": [
    {
      "name": "Featured Collections",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
