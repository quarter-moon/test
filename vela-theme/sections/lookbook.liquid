<!-- Lookbook — 3-image asymmetric spread, matches VDeskHome lookbook -->
<section class="lookbook-section">
  <div class="lookbook-header fade-up">
    {%- if section.settings.eyebrow != blank -%}
      <div class="lookbook-eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="lookbook-title">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.caption != blank -%}
      <p class="lookbook-caption">{{ section.settings.caption }}</p>
    {%- endif -%}
  </div>

  <div class="lookbook-grid">
    <div class="lookbook-img-a fade-up">
      {%- if section.settings.image_1 != blank -%}
        <img
          src="{{ section.settings.image_1 | image_url: width: 900 }}"
          srcset="{{ section.settings.image_1 | image_url: width: 600 }} 600w, {{ section.settings.image_1 | image_url: width: 900 }} 900w"
          sizes="(min-width: 768px) 30vw, 100vw"
          alt="{{ section.settings.image_1.alt | escape }}"
          loading="lazy"
        >
      {%- else -%}
        <div style="background:var(--pebble); width:100%; aspect-ratio:3/4;"></div>
      {%- endif -%}
    </div>

    <div class="lookbook-img-b fade-up">
      {%- if section.settings.image_2 != blank -%}
        <img
          src="{{ section.settings.image_2 | image_url: width: 1100 }}"
          srcset="{{ section.settings.image_2 | image_url: width: 700 }} 700w, {{ section.settings.image_2 | image_url: width: 1100 }} 1100w"
          sizes="(min-width: 768px) 40vw, 100vw"
          alt="{{ section.settings.image_2.alt | escape }}"
          loading="lazy"
        >
      {%- else -%}
        <div style="background:var(--pebble); width:100%; aspect-ratio:4/5;"></div>
      {%- endif -%}
    </div>

    <div class="lookbook-img-c fade-up">
      {%- if section.settings.image_3 != blank -%}
        <img
          src="{{ section.settings.image_3 | image_url: width: 900 }}"
          srcset="{{ section.settings.image_3 | image_url: width: 600 }} 600w, {{ section.settings.image_3 | image_url: width: 900 }} 900w"
          sizes="(min-width: 768px) 30vw, 100vw"
          alt="{{ section.settings.image_3.alt | escape }}"
          loading="lazy"
        >
      {%- else -%}
        <div style="background:var(--pebble); width:100%; aspect-ratio:3/4;"></div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.cta_label != blank -%}
    <div class="lookbook-cta fade-up">
      <a href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_label }}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Lookbook",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Look 04 · Worn With Nothing" },
    { "type": "text", "id": "title", "label": "Title", "default": "An almost-uniform." },
    { "type": "textarea", "id": "caption", "label": "Caption", "default": "The Brera Trouser · The Linen Camisole · The Field Coat — photographed in May, in one quiet room." },
    { "type": "image_picker", "id": "image_1", "label": "Left image" },
    { "type": "image_picker", "id": "image_2", "label": "Centre image (largest)" },
    { "type": "image_picker", "id": "image_3", "label": "Right image" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "View the full lookbook →" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ],
  "presets": [
    { "name": "Lookbook" }
  ]
}
{% endschema %}
