<!-- Category Strip — horizontal scroll mobile, 5-col desktop -->
<section class="category-strip">

  <!-- Desktop header row (hidden on mobile via CSS) -->
  <div class="category-strip-header-row" style="display:none">
    <div>
      <div class="category-strip-eyebrow label-caps">{{ section.settings.eyebrow | default: 'Browse' }}</div>
      <h2 class="category-strip-heading">{{ section.settings.heading | default: 'The Categories' }}</h2>
    </div>
    {%- if section.settings.subheading != blank -%}
      <div class="category-strip-sub">{{ section.settings.subheading }}</div>
    {%- endif -%}
  </div>

  <div class="category-strip-scroll">
    {%- for block in section.blocks -%}
      {%- if block.type == 'category' -%}
        {%- assign coll = collections[block.settings.collection] -%}
        <a href="{{ coll.url | default: block.settings.custom_url | default: routes.collections_url }}" class="category-strip-item" {{ block.shopify_attributes }}>
          <div class="category-strip-item-image">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                srcset="{{ block.settings.image | image_url: width: 300 }} 300w, {{ block.settings.image | image_url: width: 600 }} 600w"
                sizes="(min-width: 1024px) 20vw, 100px"
                alt="{{ block.settings.image.alt | escape | default: block.settings.label }}"
                width="100" height="130" loading="lazy"
              >
            {%- elsif coll.featured_image -%}
              <img
                src="{{ coll.featured_image | image_url: width: 600 }}"
                srcset="{{ coll.featured_image | image_url: width: 300 }} 300w, {{ coll.featured_image | image_url: width: 600 }} 600w"
                sizes="(min-width: 1024px) 20vw, 100px"
                alt="{{ coll.featured_image.alt | escape | default: coll.title }}"
                width="100" height="130" loading="lazy"
              >
            {%- else -%}
              {%- assign cat_label = block.settings.label | downcase -%}
              {%- if cat_label contains 'dress' -%}
                {%- assign demo_photo = '1496747611176-843222e1e57c' -%}
              {%- elsif cat_label contains 'knit' -%}
                {%- assign demo_photo = '1566174053879-31528523f8ae' -%}
              {%- elsif cat_label contains 'tailor' -%}
                {%- assign demo_photo = '1485125639709-a60c3a500bf1' -%}
              {%- elsif cat_label contains 'outer' or cat_label contains 'coat' -%}
                {%- assign demo_photo = '1539109136881-3be0616acf4b' -%}
              {%- else -%}
                {%- assign demo_photo = '1490481651871-ab68de25d43d' -%}
              {%- endif -%}
              <img
                src="https://images.unsplash.com/photo-{{ demo_photo }}?w=600&q=80&auto=format&fit=crop"
                srcset="
                  https://images.unsplash.com/photo-{{ demo_photo }}?w=300&q=80&auto=format&fit=crop 300w,
                  https://images.unsplash.com/photo-{{ demo_photo }}?w=600&q=80&auto=format&fit=crop 600w
                "
                sizes="(min-width: 1024px) 20vw, 100px"
                alt="{{ block.settings.label }}"
                width="100" height="130" loading="lazy"
                style="width:100%;height:100%;object-fit:cover;object-position:center top;"
              >
            {%- endif -%}
          </div>
          <!-- Desktop: label row below image -->
          <div class="category-strip-item-label-row" style="display:none">
            <div>
              <div class="category-strip-item-name">{{ block.settings.label | default: coll.title }}</div>
              <div class="category-strip-item-sub">{{ block.settings.sub | default: coll.products_count | append: ' pieces' }}</div>
            </div>
            <div class="category-strip-item-cta">Shop →</div>
          </div>
          <!-- Mobile: name + cta below image -->
          <div class="category-strip-item-name" style="">{{ block.settings.label | default: coll.title }}</div>
          <div class="category-strip-item-cta">Shop →</div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<style>
@media (min-width: 1024px) {
  .category-strip .category-strip-header-row { display: flex !important; }
  .category-strip-item .category-strip-item-label-row { display: flex !important; }
  .category-strip-item > .category-strip-item-name,
  .category-strip-item > .category-strip-item-cta { display: none; }
}
</style>

{% schema %}
{
  "name": "Category Strip",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (desktop)", "default": "Browse" },
    { "type": "text", "id": "heading", "label": "Heading (desktop)", "default": "The Categories" },
    { "type": "text", "id": "subheading", "label": "Subheading (desktop right)", "default": "A small selection, made well." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Override image" },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "sub", "label": "Subtitle (desktop, e.g. piece count)", "default": "Resort 26" },
        { "type": "url", "id": "custom_url", "label": "Custom URL (if no collection)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Strip",
      "blocks": [
        { "type": "category", "settings": { "label": "New In", "sub": "Resort 26" } },
        { "type": "category", "settings": { "label": "Dresses", "sub": "08 pieces" } },
        { "type": "category", "settings": { "label": "Knitwear", "sub": "12 pieces" } },
        { "type": "category", "settings": { "label": "Outerwear", "sub": "04 pieces" } },
        { "type": "category", "settings": { "label": "Tailoring", "sub": "06 pieces" } }
      ]
    }
  ]
}
{% endschema %}
