<div class="collection-header">
  <div class="collection-header-eyebrow fade-up">Shop</div>
  <h1 class="collection-header-title fade-up">All Collections</h1>
  <div class="collection-header-rule fade-up" aria-hidden="true"></div>
</div>

<div class="container" style="padding-bottom: 80px;">
  <div class="list-collections-grid">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        <a href="{{ collection.url }}" class="list-collection-card fade-up">
          <div class="list-collection-img">
            {%- if collection.featured_image -%}
              <img
                src="{{ collection.featured_image | image_url: width: 600 }}"
                srcset="{{ collection.featured_image | image_url: width: 400 }} 400w, {{ collection.featured_image | image_url: width: 600 }} 600w, {{ collection.featured_image | image_url: width: 900 }} 900w"
                sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw"
                alt="{{ collection.title | escape }}"
                loading="lazy"
              >
            {%- else -%}
              <div style="width:100%; height:100%; background: var(--pebble); display:flex; align-items:center; justify-content:center;">
                <span style="font-family: var(--font-heading); font-size: 24px; color: var(--ash); letter-spacing: 0.1em;">{{ collection.title | slice: 0 }}</span>
              </div>
            {%- endif -%}
          </div>
          <div class="list-collection-info">
            <h2 class="list-collection-title">{{ collection.title }}</h2>
            <span class="list-collection-count">{{ collection.products_count }} pieces</span>
          </div>
        </a>
      {%- endunless -%}
    {%- else -%}
      <p style="grid-column: 1/-1; text-align:center; font-family: var(--font-heading); font-style:italic; font-size:20px; color:var(--ash); padding: 60px 0;">
        No collections yet.
      </p>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections List",
  "settings": []
}
{% endschema %}
