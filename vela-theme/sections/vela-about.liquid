{%- assign pg = page -%}

<!-- ══════════════════════════════════════════════════
     VELA — About / Our Story page
     Content via page.content (Matrixify-importable)
     ══════════════════════════════════════════════════ -->

<!-- ── Nº 01 · Intro ──────────────────────────────── -->
<section class="ab-intro">
  <div class="ab-intro-inner ab-container">
    <!-- Left: metadata column -->
    <div class="ab-meta-col">
      <div class="ab-breadcrumb">Home &mdash; <strong>The Studio</strong></div>
      <div class="ab-meta-rows">
        <div class="ab-meta-row">
          <span class="ab-meta-key">Founded</span>
          <span class="ab-meta-val">{{ section.settings.meta_founded | default: 'Copenhagen, 2019' }}</span>
        </div>
        <div class="ab-meta-row">
          <span class="ab-meta-key">Editions</span>
          <span class="ab-meta-val">{{ section.settings.meta_editions | default: '014 · Resort 26' }}</span>
        </div>
        <div class="ab-meta-row">
          <span class="ab-meta-key">Ateliers</span>
          <span class="ab-meta-val">{{ section.settings.meta_ateliers | default: 'Porto · Como · Biella' }}</span>
        </div>
        <div class="ab-meta-row">
          <span class="ab-meta-key">People</span>
          <span class="ab-meta-val">{{ section.settings.meta_people | default: 'Eleven' }}</span>
        </div>
      </div>
    </div>

    <!-- Right: hero copy -->
    <div class="ab-hero-copy">
      <h1 class="ab-intro-heading">
        {{ section.settings.intro_heading | default: 'A small house for <em>quiet</em>, made things.' }}
      </h1>
      <p class="ab-intro-lede">{{ section.settings.intro_lede | default: 'VELA is the work of a small team committed to making fewer things, more carefully. Twelve pieces per collection, cut in Portugal and Italy, kept in short editions.' }}</p>
    </div>
  </div>
  <div class="ab-intro-bg-text" aria-hidden="true">About</div>
</section>

<!-- ── Nº 02 · Manifesto ───────────────────────────── -->
<section class="ab-manifesto">
  <div class="ab-container">
    <div class="ab-section-header">
      <div class="ab-eyebrow">Nº 02 · Manifesto</div>
      <h2 class="ab-section-heading">{{ section.settings.manifesto_heading | default: "Six things we mean — and a <em>few</em> we don't." }}</h2>
    </div>

    <div class="ab-tenets">
      {%- assign tenet_nums = 'i.,ii.,iii.,iv.,v.,vi.' | split: ',' -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'tenet' -%}
          <div class="ab-tenet" {{ block.shopify_attributes }}>
            <div class="ab-tenet-num">{{ tenet_nums[forloop.index0] }}</div>
            <h3 class="ab-tenet-title">{{ block.settings.title }}</h3>
            <p class="ab-tenet-body">{{ block.settings.body }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
      {%- if section.blocks == empty -%}
        <div class="ab-tenet">
          <div class="ab-tenet-num">i.</div>
          <h3 class="ab-tenet-title">Small editions, never <em>collections</em></h3>
          <p class="ab-tenet-body">Forty to sixty pieces per style. Not one more. When they are gone, they are gone.</p>
        </div>
        <div class="ab-tenet">
          <div class="ab-tenet-num">ii.</div>
          <h3 class="ab-tenet-title">Natural fibres, named <em>mills</em></h3>
          <p class="ab-tenet-body">Linen from Como (since 1894), wool from Biella, cotton from Porto. We visit before we commission.</p>
        </div>
        <div class="ab-tenet">
          <div class="ab-tenet-num">iii.</div>
          <h3 class="ab-tenet-title">Cut to the body, not the <em>warehouse</em></h3>
          <p class="ab-tenet-body">Every pattern is hand-adjusted. We do not produce to stock.</p>
        </div>
        <div class="ab-tenet">
          <div class="ab-tenet-num">iv.</div>
          <h3 class="ab-tenet-title">Mended free, <em>forever</em></h3>
          <p class="ab-tenet-body">Any VELA garment, repaired at cost for as long as we exist. No exceptions.</p>
        </div>
        <div class="ab-tenet">
          <div class="ab-tenet-num">v.</div>
          <h3 class="ab-tenet-title">One price, all <em>year</em></h3>
          <p class="ab-tenet-body">We do not hold sales. Prices are set to be final prices.</p>
        </div>
        <div class="ab-tenet">
          <div class="ab-tenet-num">vi.</div>
          <h3 class="ab-tenet-title">Quiet, <em>on purpose</em></h3>
          <p class="ab-tenet-body">No paid advertising. No collaborations. A bi-weekly letter, and the clothes.</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<!-- ── Nº 03 · Lineage ─────────────────────────────── -->
<section class="ab-lineage">
  <div class="ab-container">
    <div class="ab-section-header ab-section-header--light">
      <div class="ab-eyebrow ab-eyebrow--light">Nº 03 · Lineage</div>
      <h2 class="ab-section-heading ab-section-heading--light">{{ section.settings.lineage_heading | default: 'Seven years, kept <em>short</em>.' }}</h2>
      <p class="ab-lineage-sub">{{ section.settings.lineage_sub | default: 'A record of decisions, not milestones.' }}</p>
    </div>
    <div class="ab-timeline">
      <div class="ab-moment">
        <div class="ab-moment-year">{{ section.settings.year_1 | default: '2019' }}</div>
        <h4 class="ab-moment-title">{{ section.settings.year_1_title | default: 'The first cut' }}</h4>
        <p class="ab-moment-body">{{ section.settings.year_1_body | default: 'A coat, two shirts, three trousers. Twelve pieces. We sold them from a table in a borrowed studio.' }}</p>
      </div>
      <div class="ab-moment">
        <div class="ab-moment-year">{{ section.settings.year_2 | default: '2020' }}</div>
        <h4 class="ab-moment-title">{{ section.settings.year_2_title | default: 'Porto, by handshake' }}</h4>
        <p class="ab-moment-body">{{ section.settings.year_2_body | default: 'Partnership with the Bento atelier in Porto. A family business since 1968. We have made every piece there since.' }}</p>
      </div>
      <div class="ab-moment">
        <div class="ab-moment-year">{{ section.settings.year_3 | default: '2021' }}</div>
        <h4 class="ab-moment-title">{{ section.settings.year_3_title | default: 'The mending desk' }}</h4>
        <p class="ab-moment-body">{{ section.settings.year_3_body | default: 'Free repair service launched. Forty-one garments mended in the first year. The number grows every season.' }}</p>
      </div>
      <div class="ab-moment">
        <div class="ab-moment-year">{{ section.settings.year_4 | default: '2023' }}</div>
        <h4 class="ab-moment-title">{{ section.settings.year_4_title | default: 'Como, since 1894' }}</h4>
        <p class="ab-moment-body">{{ section.settings.year_4_body | default: 'Partnership with a linen mill in Como. Their looms are older than anyone working in the building.' }}</p>
      </div>
      <div class="ab-moment">
        <div class="ab-moment-year">{{ section.settings.year_5 | default: '2026' }}</div>
        <h4 class="ab-moment-title">{{ section.settings.year_5_title | default: 'Edition Nº 014' }}</h4>
        <p class="ab-moment-body">{{ section.settings.year_5_body | default: 'Resort 26. Forty pieces, six ateliers, eleven months from concept to garment.' }}</p>
      </div>
    </div>
  </div>
</section>

<!-- ── Nº 04 · A Letter (page.content) ────────────── -->
<section class="ab-letter">
  <div class="ab-container">
    <div class="ab-letter-grid">
      <!-- Image -->
      <figure class="ab-letter-image">
        {%- if section.settings.letter_image -%}
          <img
            src="{{ section.settings.letter_image | image_url: width: 900 }}"
            srcset="{{ section.settings.letter_image | image_url: width: 600 }} 600w, {{ section.settings.letter_image | image_url: width: 900 }} 900w"
            sizes="(min-width: 1024px) 38vw, 90vw"
            alt="{{ section.settings.letter_image.alt | default: 'The Studio' | escape }}"
            loading="lazy"
          >
        {%- else -%}
          <div class="ab-letter-image-placeholder">Atelier</div>
        {%- endif -%}
        <figcaption class="ab-letter-caption">{{ section.settings.letter_caption | default: 'Porto atelier · Spring 2025' }}</figcaption>
      </figure>

      <!-- Body text — rendered from page.content (Matrixify-importable) -->
      <div class="ab-letter-body">
        <div class="ab-eyebrow">Nº 04 · A Letter</div>
        <h2 class="ab-letter-heading">{{ section.settings.letter_heading | default: 'We started VELA in an apartment <em>above a bakery</em>.' }}</h2>

        <div class="ab-letter-content">
          {%- if pg.content != blank -%}
            {{ pg.content }}
          {%- else -%}
            <p>The brief was simple: twelve pieces, made in Europe, priced honestly. We did not have a studio, a stockist, or a manufacturer. We had a list and a small amount of conviction that the list was right.</p>
            <blockquote><p>"We don't want to be a label people wear because it is fashionable. We want to be the clothes they reach for because they are right."</p></blockquote>
            <p>Seven years later the brief has not changed. Twelve pieces. Made in Portugal and Italy. Priced to last.</p>
          {%- endif -%}
        </div>

        <!-- Founder signature -->
        <div class="ab-signature">
          {%- if section.settings.founder_image -%}
            <img
              src="{{ section.settings.founder_image | image_url: width: 112 }}"
              alt="{{ section.settings.founder_name | default: 'Mae Lindqvist' }}"
              class="ab-signature-portrait"
            >
          {%- else -%}
            <div class="ab-signature-portrait ab-signature-portrait--placeholder">ML</div>
          {%- endif -%}
          <div>
            <div class="ab-signature-name">{{ section.settings.founder_name | default: 'Mae Lindqvist' }}</div>
            <div class="ab-signature-role">{{ section.settings.founder_role | default: 'Founder & Creative Director' }}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── Nº 05 · The Ateliers ────────────────────────── -->
<section class="ab-ateliers">
  <div class="ab-container">
    <div class="ab-section-header">
      <div class="ab-eyebrow">Nº 05 · The Ateliers</div>
      <h2 class="ab-section-heading">The hands behind <em>the work</em>.</h2>
    </div>
    <div class="ab-atelier-list">
      <div class="ab-atelier-row ab-atelier-row--head">
        <span></span>
        <span>Atelier</span>
        <span>Location</span>
        <span>Craft</span>
        <span>Since</span>
      </div>
      {%- assign ateliers = '01|Manifattura del Lago|Como, Italy|Linen Weaving|1894,02|Atelier Bento|Porto, Portugal|Cut & Make|1968,03|Biella Lanificio|Biella, Italy|Tailoring|1947,04|Casa Sant Jordi|Catalonia, Spain|Dyeing|1903,05|Hawick Craft|Scottish Borders|Wool Knitting|1921,06|Studio Lindqvist|Copenhagen, DK|Pattern & Sample|2019' | split: ',' -%}
      {%- for atelier in ateliers -%}
        {%- assign parts = atelier | split: '|' -%}
        <div class="ab-atelier-row">
          <span class="ab-atelier-num">{{ parts[0] }}</span>
          <span class="ab-atelier-name">{{ parts[1] }}</span>
          <span class="ab-atelier-where">{{ parts[2] }}</span>
          <span class="ab-atelier-craft">{{ parts[3] }}</span>
          <span class="ab-atelier-since">{{ parts[4] }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- ── Nº 06 · Numbers ─────────────────────────────── -->
<section class="ab-numbers">
  <div class="ab-container">
    <div class="ab-numbers-grid">
      <div class="ab-number-item">
        <span class="ab-number-val">{{ section.settings.stat_1_num | default: '52' }}</span>
        <span class="ab-number-label">{{ section.settings.stat_1_label | default: 'days to make one garment' }}</span>
      </div>
      <div class="ab-number-item">
        <span class="ab-number-val">{{ section.settings.stat_2_num | default: '11' }}</span>
        <span class="ab-number-label">{{ section.settings.stat_2_label | default: 'pairs of hands on each piece' }}</span>
      </div>
      <div class="ab-number-item">
        <span class="ab-number-val">{{ section.settings.stat_3_num | default: '40' }}</span>
        <span class="ab-number-label">{{ section.settings.stat_3_label | default: 'pieces per style, maximum' }}</span>
      </div>
      <div class="ab-number-item">
        <span class="ab-number-val">{{ section.settings.stat_4_num | default: '0' }}</span>
        <span class="ab-number-label">{{ section.settings.stat_4_label | default: 'fabric surplus — ever' }}</span>
      </div>
    </div>
  </div>
</section>

<!-- ── Nº 07 · CTA Strip ───────────────────────────── -->
<section class="ab-cta-strip">
  <div class="ab-container">
    <div class="ab-cta-grid">
      <h2 class="ab-cta-heading">{{ section.settings.cta_heading | default: 'Come and <em>see</em> the work.' }}</h2>
      <div class="ab-cta-actions">
        <a href="{{ section.settings.cta_primary_url | default: '/pages/contact' }}" class="ab-cta-btn ab-cta-btn--solid">
          {{ section.settings.cta_primary_label | default: 'Book the Studio →' }}
        </a>
        <a href="{{ section.settings.cta_secondary_url | default: '/collections/all' }}" class="ab-cta-btn">
          {{ section.settings.cta_secondary_label | default: 'Shop Edition 014' }}
        </a>
      </div>
    </div>
  </div>
  <div class="ab-cta-glow" aria-hidden="true"></div>
</section>

