{% layout 'theme' %}

<div style="min-height:60vh; display:flex; align-items:center; justify-content:center; text-align:center; padding:40px 24px;">
  <div>
    <p class="label-caps" style="margin-bottom:16px;">404</p>
    <h1 style="font-family:var(--font-heading); font-size:clamp(32px,8vw,72px); font-weight:300; margin-bottom:16px; line-height:1;">Page not found.</h1>
    <p style="font-family:var(--font-heading); font-style:italic; font-size:18px; color:var(--ash); margin-bottom:32px;">This page has moved on.</p>
    <a href="{{ routes.root_url }}" class="btn btn-primary">Return Home</a>
  </div>
</div>
