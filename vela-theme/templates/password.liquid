<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }} — Coming Soon</title>
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;1,300&family=DM+Sans:wght@300;400&display=swap" rel="stylesheet">
  {{ 'vela.css' | asset_url | stylesheet_tag }}
</head>
<body style="min-height:100vh; background:var(--ink); display:flex; flex-direction:column; align-items:center; justify-content:center; padding:24px;">
  <div class="hero-corner hero-corner--tl"></div>
  <div class="hero-corner hero-corner--tr"></div>
  <div class="hero-corner hero-corner--bl"></div>
  <div class="hero-corner hero-corner--br"></div>

  <div style="text-align:center; max-width:480px;">
    <p style="font-family:var(--font-heading); font-size:48px; font-weight:300; letter-spacing:0.4em; color:var(--stone); margin-bottom:8px;">VELA</p>
    <p style="font-family:var(--font-body); font-size:9px; letter-spacing:0.3em; text-transform:uppercase; color:var(--clay); margin-bottom:40px;">Studio</p>
    <div style="width:40px; height:0.5px; background:var(--clay); margin:0 auto 32px;"></div>
    <p style="font-family:var(--font-heading); font-style:italic; font-size:22px; font-weight:300; color:rgba(245,244,242,0.6); margin-bottom:48px;">Something beautiful is coming.</p>

    {% form 'storefront_password' %}
      <div style="display:flex; flex-direction:column; gap:8px; max-width:360px; margin:0 auto;">
        <input
          type="password"
          name="password"
          placeholder="{{ 'general.password_page.password_placeholder' | t }}"
          style="background:rgba(245,244,242,0.06); border:1px solid rgba(245,244,242,0.15); color:var(--stone); padding:14px 20px; font-size:13px; font-family:var(--font-body); outline:none; text-align:center;"
          autofocus
        >
        {%- if form.errors -%}
          <p style="color:var(--promo); font-size:11px;">{{ 'general.password_page.error' | t }}</p>
        {%- endif -%}
        <button type="submit" class="btn btn-primary">{{ 'general.password_page.submit' | t }}</button>
      </div>
    {% endform %}

    <p style="font-size:9px; letter-spacing:0.1em; color:rgba(245,244,242,0.25); margin-top:32px;">
      vela-studio.com
    </p>
  </div>
</body>
</html>
