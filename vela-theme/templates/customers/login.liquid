{% layout 'theme' %}

<div style="min-height:60vh; display:flex; align-items:center; justify-content:center; padding:40px 24px;">
  <div style="width:100%; max-width:400px;">
    <p class="label-caps" style="text-align:center; margin-bottom:16px;">Account</p>
    <h1 style="font-family:var(--font-heading); font-size:36px; font-weight:300; text-align:center; margin-bottom:40px;">{{ 'customer.login.title' | t }}</h1>

    {% form 'customer_login' %}
      {%- if form.errors -%}
        <div style="background:rgba(217,79,61,0.1); border:1px solid var(--promo); padding:12px 16px; margin-bottom:20px; font-size:12px; color:var(--promo);">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div style="display:flex; flex-direction:column; gap:12px; margin-bottom:24px;">
        <div>
          <label style="font-size:9px; letter-spacing:0.2em; text-transform:uppercase; color:var(--ash); display:block; margin-bottom:6px;">{{ 'customer.login.email' | t }}</label>
          <input type="email" name="customer[email]" autocomplete="email" required
            style="width:100%; border:1px solid var(--pebble); padding:14px; font-size:14px; font-family:var(--font-body); outline:none; background:transparent; transition:border-color 0.3s;"
          >
        </div>
        <div>
          <label style="font-size:9px; letter-spacing:0.2em; text-transform:uppercase; color:var(--ash); display:block; margin-bottom:6px;">{{ 'customer.login.password' | t }}</label>
          <input type="password" name="customer[password]" autocomplete="current-password" required
            style="width:100%; border:1px solid var(--pebble); padding:14px; font-size:14px; font-family:var(--font-body); outline:none; background:transparent; transition:border-color 0.3s;"
          >
        </div>
      </div>

      <button type="submit" class="btn btn-dark btn-full" style="margin-bottom:12px;">{{ 'customer.login.submit' | t }}</button>
      <a href="{{ routes.account_recover_url }}" style="display:block; text-align:center; font-size:10px; letter-spacing:0.1em; color:var(--ash); text-decoration:underline;">
        {{ 'customer.login.forgot' | t }}
      </a>
    {% endform %}

    <div style="margin-top:32px; padding-top:24px; border-top:1px solid var(--pebble); text-align:center;">
      <p style="font-size:12px; color:var(--ash); margin-bottom:12px;">{{ 'customer.login.no_account' | t }}</p>
      <a href="{{ routes.account_register_url }}" class="btn btn-outline">{{ 'customer.login.sign_up' | t }}</a>
    </div>
  </div>
</div>
