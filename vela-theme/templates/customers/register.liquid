{% layout 'theme' %}

<div style="min-height:60vh; display:flex; align-items:center; justify-content:center; padding:40px 24px;">
  <div style="width:100%; max-width:400px;">
    <p class="label-caps" style="text-align:center; margin-bottom:16px;">Account</p>
    <h1 style="font-family:var(--font-heading); font-size:36px; font-weight:300; text-align:center; margin-bottom:40px;">{{ 'customer.register.title' | t }}</h1>

    {% form 'create_customer' %}
      {%- if form.errors -%}
        <div style="background:rgba(217,79,61,0.1); border:1px solid var(--promo); padding:12px 16px; margin-bottom:20px; font-size:12px; color:var(--promo);">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div style="display:flex; flex-direction:column; gap:12px; margin-bottom:24px;">
        {%- for field in 'first_name,last_name,email,password' | split: ',' -%}
          <div>
            <label style="font-size:9px; letter-spacing:0.2em; text-transform:uppercase; color:var(--ash); display:block; margin-bottom:6px;">
              {{ field | replace: '_', ' ' | capitalize }}
            </label>
            <input
              type="{% if field == 'email' %}email{% elsif field == 'password' %}password{% else %}text{% endif %}"
              name="customer[{{ field }}]"
              autocomplete="{{ field | replace: '_', '-' }}"
              style="width:100%; border:1px solid var(--pebble); padding:14px; font-size:14px; font-family:var(--font-body); outline:none; background:transparent; transition:border-color 0.3s;"
            >
          </div>
        {%- endfor -%}
      </div>

      <button type="submit" class="btn btn-dark btn-full" style="margin-bottom:12px;">{{ 'customer.register.submit' | t }}</button>
    {% endform %}

    <div style="margin-top:32px; padding-top:24px; border-top:1px solid var(--pebble); text-align:center;">
      <p style="font-size:12px; color:var(--ash); margin-bottom:12px;">{{ 'customer.register.have_account' | t }}</p>
      <a href="{{ routes.account_login_url }}" class="btn btn-outline">{{ 'customer.register.sign_in' | t }}</a>
    </div>
  </div>
</div>
