<h1 style="font-size:28px;margin-bottom:8px;">{{ collection.title | default: 'All Products' }}</h1>
<p style="color:#888;margin-bottom:32px;">{{ collection.products_count }} products</p>

<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:32px;">
  {%- for product in collection.products -%}
    <a href="{{ product.url }}" style="text-decoration:none;color:#111;">
      {%- if product.featured_image -%}
        <img
          src="{{ product.featured_image | image_url: width: 500 }}"
          alt="{{ product.featured_image.alt | escape | default: product.title }}"
          width="500"
          height="500"
          style="width:100%;aspect-ratio:1;object-fit:cover;display:block;background:#eee;"
          loading="lazy"
        >
      {%- else -%}
        <div style="aspect-ratio:1;background:#eee;display:flex;align-items:center;justify-content:center;font-size:13px;color:#999;">No image</div>
      {%- endif -%}
      <p style="font-size:14px;font-weight:600;margin-top:12px;">{{ product.title }}</p>
      <p style="font-size:14px;color:#555;">{{ product.price | money }}</p>
    </a>
  {%- else -%}
    <p style="color:#888;">No products in this collection yet.</p>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Collection",
  "settings": []
}
{% endschema %}
