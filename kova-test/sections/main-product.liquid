{%- assign current_variant = product.selected_or_first_available_variant -%}

<div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start;">

  <div>
    {%- if product.featured_image -%}
      <img
        src="{{ product.featured_image | image_url: width: 800 }}"
        alt="{{ product.featured_image.alt | escape | default: product.title }}"
        width="800"
        height="800"
        style="width:100%;display:block;aspect-ratio:1;object-fit:cover;"
        loading="eager"
      >
    {%- else -%}
      <div style="background:#eee;aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:14px;color:#999;">No image</div>
    {%- endif -%}
  </div>

  <div>
    <p style="font-size:13px;color:#888;margin-bottom:8px;">{{ product.vendor }}</p>
    <h1 style="font-size:28px;font-weight:600;margin-bottom:16px;">{{ product.title }}</h1>
    <p style="font-size:20px;font-weight:500;margin-bottom:24px;">{{ current_variant.price | money }}</p>

    {%- form 'product', product, id: 'product-form' -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}">

      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <div style="margin-bottom:16px;">
            <label style="display:block;font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;margin-bottom:8px;">{{ option.name }}</label>
            <select name="options[{{ option.name | escape }}]" id="option-{{ option.position }}" style="width:100%;padding:10px 12px;border:1px solid #ddd;font-size:14px;background:#fff;">
              {%- for value in option.values -%}
                <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
              {%- endfor -%}
            </select>
          </div>
        {%- endfor -%}
      {%- endunless -%}

      <div style="margin-bottom:16px;">
        <label style="display:block;font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;margin-bottom:8px;">Quantity</label>
        <input type="number" name="quantity" value="1" min="1" style="width:80px;padding:10px 12px;border:1px solid #ddd;font-size:14px;">
      </div>

      <button
        type="submit"
        name="add"
        style="width:100%;padding:16px;background:#111;color:#fff;border:none;font-size:14px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;"
        {%- unless current_variant.available -%} disabled style="opacity:0.4;cursor:not-allowed;"{%- endunless -%}
      >
        {%- if current_variant.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
      </button>
    {%- endform -%}

    {%- if product.description != blank -%}
      <div style="margin-top:32px;font-size:14px;line-height:1.7;color:#444;">
        {{ product.description }}
      </div>
    {%- endif -%}
  </div>

</div>

<script>
  // Sync variant selects → hidden id input
  var form = document.getElementById('product-form');
  var selects = form ? form.querySelectorAll('select') : [];
  var variants = {{ product.variants | json }};

  function getSelectedVariant() {
    var opts = Array.from(selects).map(s => s.value);
    return variants.find(v =>
      v.options.every(function(o, i) { return o === opts[i]; })
    );
  }

  selects.forEach(function(sel) {
    sel.addEventListener('change', function() {
      var v = getSelectedVariant();
      if (!v) return;
      var idInput = form.querySelector('[name="id"]');
      if (idInput) idInput.value = v.id;
      var btn = form.querySelector('button[name="add"]');
      if (btn) {
        btn.disabled = !v.available;
        btn.textContent = v.available ? 'Add to Cart' : 'Sold Out';
      }
    });
  });
</script>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
